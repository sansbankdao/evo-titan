---
// apps/desktop/src/pages/settings.astro — Evo Titan
//
// Preferences and connection settings. ALL DATA IS MOCK — see src/lib/mock.ts.
// The connection section describes what rpc.ts WOULD need, not what it has: no
// transport exists and no node was reachable when this was written.
import Layout from '../layouts/Layout.astro';
import Toggle from '../components/Toggle.astro';
import { rpcSettings, notificationPrefs, appPrefs } from '../lib/mock';
---

<Layout title="Settings" active="settings">
  <div class="mx-auto w-full max-w-4xl px-6 py-6">
    <h1 class="text-xl font-semibold tracking-tight text-white">Settings</h1>
    <p class="mt-1 text-sm text-slate-400">
      Preferences are stored locally. Nothing on this screen is connected to a node yet.
    </p>

    <!--
      Connection.

      The form is rendered DISABLED and the save button does not exist. rpc.ts
      throws before dialling anything, so an enabled "Test connection" button
      would be a control that cannot succeed. The values are shown so the shape
      of the eventual form is legible, with a banner saying plainly that none of
      it is in use.
    -->
    <section class="mt-6 rounded-lg border border-titan-800 bg-titan-900/60 p-4" data-section="connection">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-sm font-semibold text-slate-200">Connection</h2>
        <span
          class="rounded-full border border-amber-500/30 bg-amber-500/10 px-2 py-0.5 text-[10px] font-medium text-amber-300"
          data-connection-status="not-implemented"
        >
          RPC not implemented
        </span>
      </div>
      <p class="mt-1 text-[11px] leading-relaxed text-slate-500">
        These are the fields a dashd connection will need. They are shown for layout only —
        nothing is dialled, and the values below are not read by any code yet.
      </p>

      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <label class="block" data-setting="host">
          <span class="text-[11px] tracking-wide text-slate-500 uppercase">Host</span>
          <input
            type="text"
            value={rpcSettings.host}
            disabled
            class="mt-1 w-full cursor-not-allowed rounded-md border border-titan-800 bg-titan-950/60 px-2.5 py-1.5 font-mono text-xs text-slate-400"
          />
        </label>

        <label class="block" data-setting="port">
          <span class="text-[11px] tracking-wide text-slate-500 uppercase">Port</span>
          <input
            type="text"
            value={rpcSettings.port}
            disabled
            class="mt-1 w-full cursor-not-allowed rounded-md border border-titan-800 bg-titan-950/60 px-2.5 py-1.5 font-mono text-xs text-slate-400"
          />
        </label>

        <label class="block" data-setting="user">
          <span class="text-[11px] tracking-wide text-slate-500 uppercase">RPC user</span>
          <input
            type="text"
            value={rpcSettings.user}
            disabled
            class="mt-1 w-full cursor-not-allowed rounded-md border border-titan-800 bg-titan-950/60 px-2.5 py-1.5 font-mono text-xs text-slate-400"
          />
        </label>

        <label class="block" data-setting="password">
          <span class="text-[11px] tracking-wide text-slate-500 uppercase">RPC password</span>
          <!--
            The password is never rendered, not even as a mock value. The field
            shows only whether one is set, so no secret-looking string is ever
            put on screen where it could be mistaken for a stored credential.
          -->
          <input
            type="password"
            value={rpcSettings.passwordSet ? '••••••••••••' : ''}
            disabled
            class="mt-1 w-full cursor-not-allowed rounded-md border border-titan-800 bg-titan-950/60 px-2.5 py-1.5 font-mono text-xs text-slate-400"
          />
          <span class="mt-0.5 block text-[10px] text-slate-600">
            {rpcSettings.passwordSet ? 'A password is set for this profile' : 'No password set'}
          </span>
        </label>

        <label class="block" data-setting="tls">
          <span class="text-[11px] tracking-wide text-slate-500 uppercase">TLS</span>
          <input
            type="text"
            value={rpcSettings.tls ? 'Enabled' : 'Disabled'}
            disabled
            class="mt-1 w-full cursor-not-allowed rounded-md border border-titan-800 bg-titan-950/60 px-2.5 py-1.5 font-mono text-xs text-slate-400"
          />
        </label>

        <label class="block" data-setting="timeout">
          <span class="text-[11px] tracking-wide text-slate-500 uppercase">Timeout</span>
          <input
            type="text"
            value={`${rpcSettings.timeoutMs.toLocaleString()} ms`}
            disabled
            class="mt-1 w-full cursor-not-allowed rounded-md border border-titan-800 bg-titan-950/60 px-2.5 py-1.5 font-mono text-xs text-slate-400"
          />
        </label>
      </div>

      <div class="mt-4 flex flex-wrap gap-2 border-t border-titan-800 pt-3">
        <button
          type="button"
          disabled
          class="cursor-not-allowed rounded-md border border-titan-800 bg-titan-900 px-3 py-1.5 text-xs font-medium text-slate-500"
          title="No RPC transport exists yet"
        >
          Test connection
        </button>
        <button
          type="button"
          disabled
          class="cursor-not-allowed rounded-md border border-titan-800 bg-titan-900 px-3 py-1.5 text-xs font-medium text-slate-500"
          title="Nothing is persisted yet"
        >
          Save
        </button>
      </div>
    </section>

    <!-- Notifications -->
    <section class="mt-4 rounded-lg border border-titan-800 bg-titan-900/60 p-4" data-section="notifications">
      <h2 class="text-sm font-semibold text-slate-200">Notifications</h2>
      <p class="mt-0.5 text-[11px] text-slate-500">
        Delivery is not implemented — no mail or push transport exists yet.
      </p>
      <div class="mt-2">
        {notificationPrefs.map((pref) => <Toggle {...pref} />)}
      </div>
    </section>

    <!-- Application -->
    <section class="mt-4 rounded-lg border border-titan-800 bg-titan-900/60 p-4" data-section="application">
      <h2 class="text-sm font-semibold text-slate-200">Application</h2>
      <p class="mt-0.5 text-[11px] text-slate-500">
        Only settings that already affect this build are enabled.
      </p>
      <div class="mt-2">
        {appPrefs.map((pref) => <Toggle {...pref} />)}
      </div>
    </section>

    <!-- About -->
    <section class="mt-4 rounded-lg border border-titan-800 bg-titan-900/60 p-4" data-section="about">
      <h2 class="text-sm font-semibold text-slate-200">About</h2>
      <dl class="mt-3 space-y-2.5 text-xs">
        <div class="flex justify-between gap-4">
          <dt class="text-slate-500">Version</dt>
          <dd class="font-mono text-slate-300" data-setting="version">26.9.25</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-slate-500">Data source</dt>
          <dd class="font-mono text-amber-400/80">Mock</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-slate-500">Documentation</dt>
          <dd>
            <a
              href="https://docs.evotitan.app/"
              class="text-titan-300 underline decoration-titan-500/40 underline-offset-2 hover:text-titan-200"
            >
              docs.evotitan.app
            </a>
          </dd>
        </div>
      </dl>
    </section>
  </div>
</Layout>
