---
// apps/desktop/src/pages/index.astro — Evo Titan
//
// The fleet dashboard. ALL DATA IS MOCK — see src/lib/mock.ts. No RPC call is
// made; the RPC seam in src/lib/rpc.ts throws by design.
import Layout from '../layouts/Layout.astro';
import HealthBadge from '../components/HealthBadge.astro';
import RewardsChart from '../components/RewardsChart.astro';
import HealthChart from '../components/HealthChart.astro';
import {
  fleet,
  summary,
  activity,
  dash,
  short,
  rewardsSeries,
  healthBreakdown,
  yieldModel,
  nodeEarnings,
  shareEarnings,
  poolShareEarnings,
  fees,
  dash4,
} from '../lib/mock';

const formatDuration = (seconds: number): string => {
  if (seconds <= 0) return '—';
  const h = Math.floor(seconds / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  return h > 0 ? `${h}h ${m}m` : `${m}m`;
};

const healthOrder = { enabled: 0, posing: 1, expired: 2, down: 3 };
const sorted = [...fleet].sort((a, b) => healthOrder[a.health] - healthOrder[b.health]);
---

<Layout title="Fleet" active="fleet" nodeLive>
  <div class="mx-auto w-full max-w-6xl px-6 py-6">
    <!--
      LIVE FLEET (Phase 1). Shown when Demo Mode is off AND a node is
      configured (global.css keys this off data-node='configured'); reads
      `protx list wallet`, getblockchaininfo, getnetworkinfo and
      getdeploymentinfo from the operator's own node through the verified
      Rust-proxy transport. Every card carries its own status: a failed fetch
      renders an error line where the numbers would be, never a blank card.
      The Network status card is a real read of dapi.sansbank.dev (our own
      proxy; CORS `*`, measured 2026-11-23) for BOTH networks — including the
      core chain-locked height the public seed does not expose — with the
      public testnet seed as a labelled fallback. No local node needed.
    -->
    <div data-live-content>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-xl font-semibold tracking-tight text-white">Fleet</h1>
          <p class="mt-1 text-sm text-slate-400" data-live-summary>Reading from your node…</p>
        </div>
        <button
          type="button"
          data-live-refresh
          class="cursor-pointer rounded-md border border-titan-500/40 bg-titan-500/10 px-3 py-1.5 text-xs font-medium text-titan-200 hover:bg-titan-500/20"
        >
          Refresh
        </button>
      </div>

      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border border-titan-800 bg-titan-900/60 p-4">
          <p class="text-xs tracking-wide text-slate-500 uppercase">Nodes (wallet)</p>
          <p class="mt-1.5 font-mono text-lg text-slate-100" data-live-total>—</p>
        </div>
        <div class="rounded-lg border border-titan-800 bg-titan-900/60 p-4">
          <p class="text-xs tracking-wide text-slate-500 uppercase">Collateral</p>
          <p class="mt-1.5 font-mono text-lg text-slate-100" data-live-collateral>—</p>
        </div>
        <div class="rounded-lg border border-titan-800 bg-titan-900/60 p-4">
          <p class="text-xs tracking-wide text-slate-500 uppercase">Shares on chain</p>
          <p class="mt-1.5 font-mono text-lg text-slate-100" data-live-shares>—</p>
        </div>
        <div class="rounded-lg border border-titan-800 bg-titan-900/60 p-4">
          <p class="text-xs tracking-wide text-slate-500 uppercase">PoSe-banned</p>
          <p class="mt-1.5 font-mono text-lg text-slate-100" data-live-pose>—</p>
        </div>
      </div>

      <div class="mt-5 grid gap-3 lg:grid-cols-2">
        <section class="rounded-lg border border-titan-800 bg-titan-900/60 p-4" data-node-info>
          <h2 class="text-sm font-semibold text-slate-200">Connected node</h2>
          <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
            <div class="flex justify-between gap-2">
              <dt class="text-slate-500">Chain</dt>
              <dd class="font-mono text-slate-300" data-node-chain>—</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="text-slate-500">Height</dt>
              <dd class="font-mono text-slate-300" data-node-height>—</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="text-slate-500">Dash Core</dt>
              <dd class="font-mono text-slate-300" data-node-version>—</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="text-slate-500">Endpoint</dt>
              <dd class="font-mono text-slate-300" data-node-endpoint>—</dd>
            </div>
          </dl>
          <p class="mt-2 text-xs text-slate-600" data-node-error></p>
        </section>

        <section class="rounded-lg border border-titan-800 bg-titan-900/60 p-4" data-deploy-card>
          <h2 class="text-sm font-semibold text-slate-200">Consensus deployments</h2>
          <p class="mt-0.5 text-xs text-slate-500">getdeploymentinfo — the v24 method; v24/evo_shares first.</p>
          <div class="mt-2 max-h-48 overflow-y-auto" data-deploy-rows></div>
        </section>
      </div>

      <section class="mt-5 rounded-lg border border-titan-800 bg-titan-900/60 p-4" data-dapi-card>
        <h2 class="text-sm font-semibold text-slate-200">Network status — DAPI</h2>
        <p class="mt-0.5 text-xs text-slate-500">
          Read live from dapi.sansbank.dev (our proxy — SDK method names, shapes adapted on our
          side), with the public testnet seed as fallback. No local node needed.
        </p>
        <p class="mt-2 font-mono text-xs text-slate-300" data-dapi-testnet>Reading…</p>
        <p class="mt-1 font-mono text-xs text-slate-400" data-dapi-mainnet>Reading…</p>
      </section>

      <div class="mt-6 overflow-hidden rounded-lg border border-titan-800">
        <table class="w-full text-left text-sm">
          <thead class="bg-titan-900/80 text-xs tracking-wide text-slate-500 uppercase">
            <tr>
              <th scope="col" class="px-4 py-2.5 font-medium">ProTx</th>
              <th scope="col" class="px-4 py-2.5 font-medium">Type</th>
              <th scope="col" class="px-4 py-2.5 font-medium">Status</th>
              <th scope="col" class="px-4 py-2.5 font-medium">Collateral</th>
              <th scope="col" class="px-4 py-2.5 font-medium">Operator cut</th>
              <th scope="col" class="px-4 py-2.5 font-medium">Registered</th>
              <th scope="col" class="px-4 py-2.5 font-medium">Shares</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-titan-800" data-live-fleet></tbody>
        </table>
        <p class="hidden border-t border-titan-800 bg-titan-950/60 px-4 py-3 text-xs text-rose-300" data-fleet-error></p>
      </div>
    </div>

    <!--
      THE MOCK FLEET. Everything from here down is the fabricated page from
      src/lib/mock.ts, unchanged, shown in Demo Mode.
    -->
    <div data-demo-content>
    <!-- Header -->
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-xl font-semibold tracking-tight text-white">Fleet</h1>
        <p class="mt-1 text-sm text-slate-400">
          {summary.totalNodes} nodes · {summary.enabled} enabled
          {summary.needsAttention > 0 && ` · ${summary.needsAttention} need attention`}
        </p>
      </div>
      <div class="flex gap-2">
        <button
          type="button"
          disabled
          class="cursor-not-allowed rounded-md border border-titan-800 bg-titan-900 px-3 py-1.5 text-xs font-medium text-slate-500"
          title="Not available yet"
        >
          Add node
        </button>
        <button
          type="button"
          disabled
          class="cursor-not-allowed rounded-md border border-titan-800 bg-titan-900 px-3 py-1.5 text-xs font-medium text-slate-500"
          title="Not available yet"
        >
          Refresh
        </button>
      </div>
    </div>

    <!-- Summary cards -->
    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-lg border border-titan-800 bg-titan-900/60 p-4">
        <p class="text-xs tracking-wide text-slate-500 uppercase">Collateral</p>
        <p class="mt-1.5 font-mono text-lg text-slate-100">{dash(summary.totalCollateral)}</p>
      </div>
      <div class="rounded-lg border border-titan-800 bg-titan-900/60 p-4">
        <p class="text-xs tracking-wide text-slate-500 uppercase">Rewards this month</p>
        <p class="mt-1.5 font-mono text-lg text-slate-100">{dash(summary.rewardsThisMonth)}</p>
      </div>
      <div class="rounded-lg border border-titan-800 bg-titan-900/60 p-4">
        <p class="text-xs tracking-wide text-slate-500 uppercase">Rewards all-time</p>
        <p class="mt-1.5 font-mono text-lg text-slate-100">{dash(summary.rewardsAllTime)}</p>
      </div>
      <div class="rounded-lg border border-titan-800 bg-titan-900/60 p-4">
        <p class="text-xs tracking-wide text-slate-500 uppercase">Next payment</p>
        <p class="mt-1.5 font-mono text-lg text-slate-100">
          {formatDuration(Math.min(...fleet.filter((n) => n.nextPaymentIn > 0).map((n) => n.nextPaymentIn)))}
        </p>
      </div>
    </div>

    <!--
      Expected earnings.

      The numbers here are NOT fabricated: they are arithmetic on Dash Core v24
      consensus, with every input cited in `mock.ts -> yieldModel`. The node
      count is the single unsourced input (live network state, unreadable with
      no node), so it is shown as an explicit assumption rather than hidden.
      The three fees are our product prices, not protocol constants.

      Ordered cheapest-trust first: full self-custody costs NOTHING because we
      hold nothing; the shared pool is coordination at 10%; custody is 30%.
    -->
    <section
      class="mt-5 rounded-lg border border-titan-500/25 bg-titan-500/5 p-4"
      data-earnings
      data-assumed-nodes={String(yieldModel.assumedNodes)}
    >
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-sm font-semibold text-slate-200">Expected earnings</h2>
        <span class="rounded-full border border-amber-500/30 bg-amber-500/10 px-2 py-0.5 text-xs font-medium text-amber-300">
          Model · {yieldModel.assumedNodes.toLocaleString()} nodes assumed
        </span>
      </div>

      <!--
        The three arrangements, each a card of the same shape, so they read as
        one row.

        This previously gave the middle card `p-2 -m-2` plus a border and a
        tint while its two siblings had no card styling at all. The negative
        margin pulled it out of its grid cell and the border and tint made that
        visible, so it appeared to float over the row instead of sitting in it.
        The fix is not to remove the highlight but to give all three the same
        box, which is also what the rewards screen already does -- the two
        screens now present the same three figures the same way.

        The recommendation stays legible as a badge on the shared card rather
        than as a layout anomaly.
      -->
      <div class="mt-3 grid gap-3 sm:grid-cols-3">
        <div
          data-earn="self-custody"
          class="rounded-lg border-2 border-emerald-500/40 bg-emerald-500/5 p-3"
        >
          <div class="flex items-baseline justify-between gap-2">
            <p class="text-xs tracking-wide text-emerald-200 uppercase">Full self-custody</p>
            <p class="font-mono text-3xl font-semibold text-emerald-300">{fees.selfCustodyPercent}%</p>
          </div>
          <p class="mt-1.5 font-mono text-xl text-slate-300">{dash4(nodeEarnings.grossPerYear)}</p>
          <p class="mt-1 text-xs text-emerald-200/70">
            {nodeEarnings.selfCustodyApy.toFixed(2)}% on 1,000 DASH — you keep all of it
          </p>
        </div>
        <!-- Both paid arrangements use a 125 DASH share so they are comparable
             directly. The shared row is the recommendation. -->
        <div
          data-earn="shared-pool"
          class="rounded-lg border border-titan-500/40 bg-titan-500/5 p-3"
        >
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <p class="text-xs tracking-wide text-titan-200 uppercase">Shared pool · your keys</p>
            <p class="font-mono text-3xl font-semibold text-titan-300">{fees.sharedPoolPercent}%</p>
          </div>
          <p class="mt-1.5 font-mono text-xl text-slate-300">{dash4(poolShareEarnings.netPerYear)}</p>
          <p class="mt-1 text-xs text-slate-500">
            {poolShareEarnings.netApy.toFixed(2)}% on a 125 DASH share, after our {fees.sharedPoolPercent}% cut
          </p>
        </div>
        <div
          data-earn="custodial"
          class="rounded-lg border border-titan-800 bg-titan-950/40 p-3"
        >
          <div class="flex items-baseline justify-between gap-2">
            <p class="text-xs tracking-wide text-slate-500 uppercase">Custodial · our keys</p>
            <p class="font-mono text-3xl font-semibold text-titan-300">{fees.custodialPercent}%</p>
          </div>
          <p class="mt-1.5 font-mono text-xl text-slate-300">{dash4(shareEarnings.netPerYear)}</p>
          <p class="mt-1 text-xs text-slate-500">
            {shareEarnings.netApy.toFixed(2)}% on a 125 DASH share, after our {fees.custodialPercent}% cut
          </p>
        </div>
      </div>

      <p class="mt-3 border-t border-titan-800/60 pt-2 text-xs leading-relaxed text-slate-500">
        Per-block reward is fixed by consensus ({yieldModel.masternodeRewardNet.toFixed(6)} DASH net of the
        {' '}{yieldModel.platformCut.toFixed(6)} DASH Platform cut). APY depends on the registered node count,
        which is the assumption shown above — not a reading. {' '}
        <a href="/rewards/" class="text-titan-300 underline decoration-dotted hover:text-titan-200">
          Full breakdown
        </a>
      </p>
    </section>

    <!--
      Charts. Both are MOCK; see src/lib/mock.ts. The trend answers "how much
      is this earning me" and the breakdown answers "is anything wrong", which
      are the two questions the summary cards above only give a single number
      for.
    -->
    <div class="mt-5 grid gap-3 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <RewardsChart points={rewardsSeries} />
      </div>
      <HealthChart breakdown={healthBreakdown} />
    </div>

    <!-- Fleet table -->
    <div class="mt-6 overflow-hidden rounded-lg border border-titan-800">
      <table class="w-full text-left text-sm">
        <thead class="bg-titan-900/80 text-xs tracking-wide text-slate-500 uppercase">
          <tr>
            <th scope="col" class="px-4 py-2.5 font-medium">Node</th>
            <th scope="col" class="px-4 py-2.5 font-medium">Status</th>
            <th scope="col" class="px-4 py-2.5 font-medium">Collateral</th>
            <th scope="col" class="px-4 py-2.5 font-medium">Version</th>
            <th scope="col" class="px-4 py-2.5 font-medium">Height</th>
            <th scope="col" class="px-4 py-2.5 font-medium">Peers</th>
            <th scope="col" class="px-4 py-2.5 font-medium">Next payment</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-titan-800">
          {
            sorted.map((node) => (
              <tr class="bg-titan-950/40 hover:bg-titan-900/40" data-node={node.id} data-kind={node.kind}>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <span class="font-medium text-slate-100">{node.alias}</span>
                    {node.kind === 'evonode' && (
                      <span class="rounded border border-titan-500/30 bg-titan-500/10 px-1.5 py-0.5 text-xs font-medium text-titan-300">
                        Evo
                      </span>
                    )}
                    {node.shares.length > 0 && (
                      <span
                        class="rounded border border-slate-700 px-1.5 py-0.5 text-xs text-slate-400"
                        title={`Shared by ${node.shares.length} owners`}
                      >
                        Shared ×{node.shares.length}
                      </span>
                    )}
                  </div>
                  <p class="selectable mt-0.5 font-mono text-xs text-slate-600" title={node.proTxHash}>
                    {short(node.proTxHash)}
                  </p>
                </td>
                <td class="px-4 py-3">
                  <HealthBadge health={node.health} />
                </td>
                <td class="px-4 py-3 font-mono text-xs text-slate-300">
                  {node.collateralAmount.toLocaleString()} DASH
                </td>
                <td class="px-4 py-3">
                  <span
                    class:list={[
                      'font-mono text-xs',
                      node.versionOk ? 'text-slate-300' : 'text-amber-400',
                    ]}
                  >
                    {node.version}
                  </span>
                </td>
                <td class="px-4 py-3 font-mono text-xs text-slate-400">
                  {node.blockHeight > 0 ? node.blockHeight.toLocaleString() : '—'}
                </td>
                <td class="px-4 py-3 font-mono text-xs text-slate-400">{node.peers || '—'}</td>
                <td class="px-4 py-3 font-mono text-xs text-slate-400">
                  {formatDuration(node.nextPaymentIn)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Activity -->
    <div class="mt-8">
      <h2 class="text-sm font-semibold text-slate-200">Recent activity</h2>
      <ul class="mt-3 space-y-2" role="list">
        {
          activity.map((entry) => (
            <li class="flex items-start gap-3 text-xs" data-activity={entry.id}>
              <span
                class:list={[
                  'mt-1 h-1.5 w-1.5 shrink-0 rounded-full',
                  entry.tone === 'ok'
                    ? 'bg-emerald-400'
                    : entry.tone === 'warn'
                      ? 'bg-amber-400'
                      : 'bg-slate-500',
                ]}
                aria-hidden="true"
              />
              <span class="text-slate-400">{entry.text}</span>
              <span class="ml-auto shrink-0 font-mono text-xs text-slate-600">
                {entry.when.slice(11, 16)} UTC
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    </div>
  </div>
</Layout>

<script>
  // The live fleet. All data flows through the tested pure modules; this script
  // only moves DOM. `protx list wallet` needs the node's wallet loaded — a
  // wallet-disabled node answers -1 "not supported when wallet is disabled",
  // which is rendered as the table's error line, not as an empty table.
  import { liveRpc } from '../lib/live-rpc';
  import { RpcError } from '../lib/rpc';
  import { toLiveNodeViews, summarizeFleet, type ProtxEntry } from '../lib/fleet-live';
  import { deploymentRows, formatCoreVersion, type DeploymentInfo } from '../lib/deployments';
  import { loadNodeConfig } from '../lib/node-config';
  import { fetchSansbankStatus, type SansbankStatusView } from '../lib/dapi-sansbank';

  const storage = window.localStorage;
  const $ = <T extends Element = HTMLElement>(sel: string): T | null => document.querySelector<T>(sel);

  function setErr(sel: string, message: string): void {
    const el = $(sel);
    if (!el) return;
    el.textContent = message;
    el.classList.remove('hidden');
  }

  function renderDeployments(dep: DeploymentInfo): void {
    const box = $('[data-deploy-rows]');
    if (!box) return;
    box.replaceChildren(
      ...deploymentRows(dep).map((r) => {
        const row = document.createElement('p');
        row.className = 'flex items-center justify-between gap-2 py-0.5 font-mono text-xs';
        const left = document.createElement('span');
        left.className = r.active ? 'text-slate-300' : 'text-slate-500';
        left.textContent = `${r.id}${r.ehf ? ' (EHF)' : ''}`;
        const right = document.createElement('span');
        right.className = r.active
          ? 'text-emerald-400/90'
          : r.status === 'started' || r.status === 'locked_in'
            ? 'text-titan-300'
            : 'text-slate-500';
        right.textContent = r.active ? `active since ${r.since}` : r.status;
        row.append(left, right);
        return row;
      }),
    );
  }

  /*
    The Sansbank proxy reader — the primary source for both networks. The
    adapter (dapi-sansbank.ts, tested against captured envelopes) does the
    shape work; this only renders. A failure on testnet falls back to the
    public seed below, with the source labelled either way — provenance is a
    separate line from data on purpose (the same rule the contested screen's
    cache provenance follows).
  */
  async function readSansbankStatus(): Promise<void> {
    const testnetEl = $('[data-dapi-testnet]');
    const mainnetEl = $('[data-dapi-mainnet]');
    const transport = async (url: string, body: string): Promise<string> => {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body,
      });
      return await res.text();
    };
    const render = (el: Element | null, label: string, v: SansbankStatusView): void => {
      if (!el) return;
      el.textContent =
        `${label} — DAPI ${v.dapiVersion} / Drive ${v.driveVersion} · ` +
        `catching_up: ${String(v.catchingUp)} · platform height ${v.platformHeight.toLocaleString()} · ` +
        `core chain height ${v.coreChainLockedHeight.toLocaleString()} · ${v.latestBlockHash.slice(0, 8)}… · ` +
        `via dapi.sansbank.dev`;
    };
    try {
      const t = await fetchSansbankStatus('testnet', transport);
      render(testnetEl, 'Testnet', t);
    } catch (e) {
      if (testnetEl) await readDapiTestnet(testnetEl, (e as Error).message);
    }
    try {
      const m = await fetchSansbankStatus('mainnet', transport);
      render(mainnetEl, 'Mainnet', m);
    } catch (e) {
      if (mainnetEl) {
        mainnetEl.textContent = `Mainnet — could not read dapi.sansbank.dev: ${(e as Error).message}`;
      }
    }
  }

  /*
    The public-seed fallback for testnet only (its method surface and shape
    are the ones measured on 2026-11-23; a mainnet seed endpoint has NOT been
    verified and is deliberately not called).
  */
  async function readDapiTestnet(statusEl: Element, priorError: string): Promise<void> {
    const url = 'https://seed-1.testnet.networks.dash.org:1443/';
    const post = async (method: string): Promise<unknown> => {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ method, id: 'evo-titan', jsonrpc: '2.0', params: {} }),
      });
      const json = (await res.json()) as { result?: unknown; error?: { message: string } };
      if (json.error) throw new Error(json.error.message);
      return json.result;
    };
    try {
      const hash = (await post('getBestBlockHash')) as string;
      const status = (await post('getStatus')) as {
        version?: {
          v0?: {
            version?: { software?: { dapi?: string; drive?: string } };
            chain?: { catching_up?: boolean };
          };
        };
      };
      const v0 = status?.version?.v0;
      const soft = v0?.version?.software;
      statusEl.textContent =
        `Testnet — DAPI ${soft?.dapi ?? '?'} / Drive ${soft?.drive ?? '?'} · ` +
        `catching_up: ${String(v0?.chain?.catching_up ?? '?')} · ` +
        `best block ${hash.slice(0, 12)}… · via public seed (sansbank proxy: ${priorError})`;
    } catch (e) {
      statusEl.textContent = `Testnet — could not read either DAPI source: ${(e as Error).message}`;
    }
  }

  async function loadFleet(): Promise<void> {
    const client = liveRpc(storage);
    const cfg = loadNodeConfig(storage);
    const endpointEl = $('[data-node-endpoint]');
    if (endpointEl && cfg) endpointEl.textContent = `${cfg.host}:${cfg.port}`;
    if (!client) {
      setErr('[data-node-error]', 'No node configured — nothing was read.');
      return;
    }
    const summaryEl = $('[data-live-summary]');
    if (summaryEl) summaryEl.textContent = 'Reading from your node…';
    try {
      const chain = await client.call<{ chain: string; blocks: number }>('getblockchaininfo');
      const net = await client.call<{ version: number; subversion: string }>('getnetworkinfo');
      const dep = await client.call<DeploymentInfo>('getdeploymentinfo');
      const entries = (await client.listMasternodes('wallet', true)) as ProtxEntry[];
      const views = toLiveNodeViews(entries);
      const sum = summarizeFleet(entries);

      const set = (sel: string, text: string): void => {
        const el = $(sel);
        if (el) el.textContent = text;
      };
      set('[data-live-total]', String(sum.total));
      set('[data-live-collateral]', `${sum.totalCollateralDash.toLocaleString()} DASH`);
      set('[data-live-shares]', String(sum.sharesOnChain));
      set('[data-live-pose]', String(sum.poseBanned));
      set('[data-node-chain]', chain.chain);
      set('[data-node-height]', chain.blocks.toLocaleString());
      set('[data-node-version]', `${formatCoreVersion(net.version)} (${net.subversion})`);
      renderDeployments(dep);
      if (summaryEl) {
        summaryEl.textContent =
          `${sum.total} node${sum.total === 1 ? '' : 's'} in this wallet · ` +
          `${sum.shared} shared · ${sum.evos} evo`;
      }

      const tbody = $('[data-live-fleet]');
      if (tbody) {
        const healthLabel: Record<string, string> = {
          enabled: 'Enabled',
          banned: 'PoSe-banned',
          revoked: 'Revoked',
        };
        const healthClass: Record<string, string> = {
          enabled: 'text-emerald-300',
          banned: 'text-amber-400',
          revoked: 'text-rose-400',
        };
        tbody.replaceChildren(
          ...views.map((v) => {
            const tr = document.createElement('tr');
            tr.className = 'bg-titan-950/40 hover:bg-titan-900/40';
            tr.setAttribute('data-live-node', v.proTxHash);
            const cells: Array<[string, string]> = [
              ['px-4 py-3', v.shortProTx],
              ['px-4 py-3 font-mono text-xs text-slate-300', v.kind === 'evo' ? 'Evo' : 'Regular'],
              [`px-4 py-3 font-mono text-xs ${healthClass[v.health]}`, healthLabel[v.health]],
              ['px-4 py-3 font-mono text-xs text-slate-300', `${(v.collateralDuffs / 1e8).toLocaleString()} DASH`],
              ['px-4 py-3 font-mono text-xs text-slate-300', `${v.operatorRewardPercent}%`],
              ['px-4 py-3 font-mono text-xs text-slate-400', v.registeredHeight.toLocaleString()],
              ['px-4 py-3 font-mono text-xs text-slate-300', v.shares.length > 0 ? String(v.shares.length) : '—'],
            ];
            cells.forEach(([cls, text], i) => {
              const td = document.createElement('td');
              td.className = cls;
              if (i === 0) {
                td.title = v.proTxHash;
                td.classList.add('selectable');
              }
              td.textContent = text;
              tr.append(td);
            });
            return tr;
          }),
        );
      }
      const errEl = $('[data-fleet-error]');
      errEl?.classList.add('hidden');
    } catch (e) {
      const msg = e instanceof RpcError ? e.message : String(e);
      if (summaryEl) summaryEl.textContent = 'The node could not be read.';
      setErr('[data-node-error]', msg);
      setErr('[data-fleet-error]', msg);
    }
  }

  $('[data-live-refresh]')?.addEventListener('click', () => void loadFleet());
  void loadFleet();
  void readSansbankStatus();
</script>
