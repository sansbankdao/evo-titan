---
// apps/desktop/src/pages/index.astro — Evo Titan
//
// The fleet dashboard. ALL DATA IS MOCK — see src/lib/mock.ts. No RPC call is
// made; the RPC seam in src/lib/rpc.ts throws by design.
import Layout from '../layouts/Layout.astro';
import HealthBadge from '../components/HealthBadge.astro';
import RewardsChart from '../components/RewardsChart.astro';
import HealthChart from '../components/HealthChart.astro';
import { fleet, summary, activity, dash, short, rewardsSeries, healthBreakdown } from '../lib/mock';

const formatDuration = (seconds: number): string => {
  if (seconds <= 0) return '—';
  const h = Math.floor(seconds / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  return h > 0 ? `${h}h ${m}m` : `${m}m`;
};

const healthOrder = { enabled: 0, posing: 1, expired: 2, down: 3 };
const sorted = [...fleet].sort((a, b) => healthOrder[a.health] - healthOrder[b.health]);
---

<Layout title="Fleet" active="fleet">
  <div class="mx-auto w-full max-w-6xl px-6 py-6">
    <!-- Header -->
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-xl font-semibold tracking-tight text-white">Fleet</h1>
        <p class="mt-1 text-sm text-slate-400">
          {summary.totalNodes} nodes · {summary.enabled} enabled
          {summary.needsAttention > 0 && ` · ${summary.needsAttention} need attention`}
        </p>
      </div>
      <div class="flex gap-2">
        <button
          type="button"
          disabled
          class="cursor-not-allowed rounded-md border border-titan-800 bg-titan-900 px-3 py-1.5 text-xs font-medium text-slate-500"
          title="Not available yet"
        >
          Add node
        </button>
        <button
          type="button"
          disabled
          class="cursor-not-allowed rounded-md border border-titan-800 bg-titan-900 px-3 py-1.5 text-xs font-medium text-slate-500"
          title="Not available yet"
        >
          Refresh
        </button>
      </div>
    </div>

    <!-- Summary cards -->
    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-lg border border-titan-800 bg-titan-900/60 p-4">
        <p class="text-[11px] tracking-wide text-slate-500 uppercase">Collateral</p>
        <p class="mt-1.5 font-mono text-lg text-slate-100">{dash(summary.totalCollateral)}</p>
      </div>
      <div class="rounded-lg border border-titan-800 bg-titan-900/60 p-4">
        <p class="text-[11px] tracking-wide text-slate-500 uppercase">Rewards this month</p>
        <p class="mt-1.5 font-mono text-lg text-slate-100">{dash(summary.rewardsThisMonth)}</p>
      </div>
      <div class="rounded-lg border border-titan-800 bg-titan-900/60 p-4">
        <p class="text-[11px] tracking-wide text-slate-500 uppercase">Rewards all-time</p>
        <p class="mt-1.5 font-mono text-lg text-slate-100">{dash(summary.rewardsAllTime)}</p>
      </div>
      <div class="rounded-lg border border-titan-800 bg-titan-900/60 p-4">
        <p class="text-[11px] tracking-wide text-slate-500 uppercase">Next payment</p>
        <p class="mt-1.5 font-mono text-lg text-slate-100">
          {formatDuration(Math.min(...fleet.filter((n) => n.nextPaymentIn > 0).map((n) => n.nextPaymentIn)))}
        </p>
      </div>
    </div>

    <!--
      Charts. Both are MOCK; see src/lib/mock.ts. The trend answers "how much
      is this earning me" and the breakdown answers "is anything wrong", which
      are the two questions the summary cards above only give a single number
      for.
    -->
    <div class="mt-5 grid gap-3 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <RewardsChart points={rewardsSeries} />
      </div>
      <HealthChart breakdown={healthBreakdown} />
    </div>

    <!-- Fleet table -->
    <div class="mt-6 overflow-hidden rounded-lg border border-titan-800">
      <table class="w-full text-left text-sm">
        <thead class="bg-titan-900/80 text-[11px] tracking-wide text-slate-500 uppercase">
          <tr>
            <th scope="col" class="px-4 py-2.5 font-medium">Node</th>
            <th scope="col" class="px-4 py-2.5 font-medium">Status</th>
            <th scope="col" class="px-4 py-2.5 font-medium">Collateral</th>
            <th scope="col" class="px-4 py-2.5 font-medium">Version</th>
            <th scope="col" class="px-4 py-2.5 font-medium">Height</th>
            <th scope="col" class="px-4 py-2.5 font-medium">Peers</th>
            <th scope="col" class="px-4 py-2.5 font-medium">Next payment</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-titan-800">
          {
            sorted.map((node) => (
              <tr class="bg-titan-950/40 hover:bg-titan-900/40" data-node={node.id} data-kind={node.kind}>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <span class="font-medium text-slate-100">{node.alias}</span>
                    {node.kind === 'evonode' && (
                      <span class="rounded border border-titan-500/30 bg-titan-500/10 px-1.5 py-0.5 text-[10px] font-medium text-titan-300">
                        Evo
                      </span>
                    )}
                    {node.shares.length > 0 && (
                      <span
                        class="rounded border border-slate-700 px-1.5 py-0.5 text-[10px] text-slate-400"
                        title={`Shared by ${node.shares.length} owners`}
                      >
                        Shared ×{node.shares.length}
                      </span>
                    )}
                  </div>
                  <p class="selectable mt-0.5 font-mono text-[10px] text-slate-600" title={node.proTxHash}>
                    {short(node.proTxHash)}
                  </p>
                </td>
                <td class="px-4 py-3">
                  <HealthBadge health={node.health} />
                </td>
                <td class="px-4 py-3 font-mono text-xs text-slate-300">
                  {node.collateralAmount.toLocaleString()} DASH
                </td>
                <td class="px-4 py-3">
                  <span
                    class:list={[
                      'font-mono text-xs',
                      node.versionOk ? 'text-slate-300' : 'text-amber-400',
                    ]}
                  >
                    {node.version}
                  </span>
                </td>
                <td class="px-4 py-3 font-mono text-xs text-slate-400">
                  {node.blockHeight > 0 ? node.blockHeight.toLocaleString() : '—'}
                </td>
                <td class="px-4 py-3 font-mono text-xs text-slate-400">{node.peers || '—'}</td>
                <td class="px-4 py-3 font-mono text-xs text-slate-400">
                  {formatDuration(node.nextPaymentIn)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Activity -->
    <div class="mt-8">
      <h2 class="text-sm font-semibold text-slate-200">Recent activity</h2>
      <ul class="mt-3 space-y-2" role="list">
        {
          activity.map((entry) => (
            <li class="flex items-start gap-3 text-xs" data-activity={entry.id}>
              <span
                class:list={[
                  'mt-1 h-1.5 w-1.5 shrink-0 rounded-full',
                  entry.tone === 'ok'
                    ? 'bg-emerald-400'
                    : entry.tone === 'warn'
                      ? 'bg-amber-400'
                      : 'bg-slate-500',
                ]}
                aria-hidden="true"
              />
              <span class="text-slate-400">{entry.text}</span>
              <span class="ml-auto shrink-0 font-mono text-[10px] text-slate-600">
                {entry.when.slice(11, 16)} UTC
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Layout>
