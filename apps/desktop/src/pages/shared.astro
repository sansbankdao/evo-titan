---
// apps/desktop/src/pages/shared.astro — Evo Titan
//
// Shared masternode ownership. ALL DATA IS MOCK — see src/lib/mock.ts.
//
// The rules shown here are the ones verified from Dash Core v24.0.0-rc.1 and
// re-verified against the current release, v24.0.3 (2026-11-23):
//   - 2-8 shares           src/evo/providertx.h:142-143 (rc.1 said 134-135)
//   - >=100 DASH per share src/evo/providertx.h:58
//   - shares sum to exactly the collateral
//   - shared registration is Regular-node ONLY while `evo_shares` is
//     inactive: v24.0.3 rejects an Evo node with `bad-protx-shares-evo` at
//     src/evo/specialtxman.cpp:1232 (rc.1 had the hard type check at
//     providertx.cpp:280). No v24.0.x release signs evo_shares; a later
//     release (v24.1) is expected to, so this is deployment-gated, not
//     permanent.
import Layout from '../layouts/Layout.astro';
import { fleet, protocol, short, fees, poolShareEarnings } from '../lib/mock';

const shared = fleet.filter((n) => n.shares.length > 0);

// Renders a proportional bar for each share, so an uneven split is visible at a
// glance. Widths are computed from the amounts, not hardcoded.
const splits = shared.map((node) => {
  const total = node.shares.reduce((sum, s) => sum + s.amount, 0);
  const signedCount = node.shares.filter((s) => s.signed).length;
  // Sourced 150 s block time (src/chainparams.cpp:200); 86,400 s per day.
  const earlyExitDays = node.earlyExit
    ? (node.earlyExit.periodBlocks * 150) / 86400
    : undefined;
  const earlyExitDash = node.earlyExit ? node.earlyExit.penaltyDuffs / 1e8 : undefined;
  return {
    node,
    total,
    signedCount,
    earlyExitDays,
    earlyExitDash,
    parts: node.shares.map((s) => ({
      ...s,
      pct: (s.amount / total) * 100,
    })),
  };
});
---

<Layout title="Shared Masternodes" active="shared" nodeLive>
  <div class="mx-auto w-full max-w-6xl px-6 py-6">
    <!--
      LIVE SHARED NODES (Phase 1). Shown when Demo Mode is off AND a node is
      configured; reads `protx list wallet` and renders every node whose
      state carries an on-chain share table (version 3 registrations). These
      are REGISTERED nodes — the share table below is the consensus record,
      not a signature-collection progress bar; pre-broadcast assembly is the
      Phase 2 product and does not exist on chain.
    -->
    <div data-live-content>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-xl font-semibold tracking-tight text-white">Shared Masternodes</h1>
          <p class="mt-1 text-sm text-slate-400" data-shared-summary>Reading from your node…</p>
        </div>
        <button
          type="button"
          data-shared-refresh
          class="cursor-pointer rounded-md border border-titan-500/40 bg-titan-500/10 px-3 py-1.5 text-xs font-medium text-titan-200 hover:bg-titan-500/20"
        >
          Refresh
        </button>
      </div>

      <div class="mt-6 space-y-4" data-shared-nodes></div>
      <p class="hidden mt-4 text-xs text-rose-300" data-shared-error></p>

      <p class="mt-6 text-xs leading-relaxed text-slate-500">
        This is the <span class="text-slate-300">self-custodial</span> pool: every share above pays its
        own reward script and we never hold a key. Our recommended cut is
        {' '}<span class="font-mono text-titan-300">{fees.sharedPoolPercent}%</span> of the gross node reward
        ({fees.sharedPoolBand.lowPercent}–{fees.sharedPoolBand.highPercent}% band), taken off the whole node
        before the split, so every share loses the same percentage of its own reward. The fee
        is fixed per registration — an operator cut cannot be changed after the fact.
      </p>
    </div>

    <!--
      THE MOCK PAGE. The fabricated shared fleet from src/lib/mock.ts,
      unchanged, shown in Demo Mode.
    -->
    <div data-demo-content>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-xl font-semibold tracking-tight text-white">Shared Masternodes</h1>
        <p class="mt-1 text-sm text-slate-400">
          {protocol.minShares}–{protocol.maxShares} co-owners per node · minimum
          {' '}{protocol.minShareAmount} DASH per share
        </p>
      </div>
      <button
        type="button"
        disabled
        class="cursor-not-allowed rounded-md border border-titan-800 bg-titan-900 px-3 py-1.5 text-xs font-medium text-slate-500"
        title="Not available yet"
      >
        Create shared node
      </button>
    </div>

    <div class="mt-6 space-y-4">
      {
        splits.map(({ node, total, parts, signedCount, earlyExitDays, earlyExitDash }) => (
          <article
            class="overflow-hidden rounded-lg border border-titan-800"
            data-shared-node={node.id}
          >
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-titan-800 bg-titan-900/60 px-4 py-3">
              <div>
                <div class="flex items-center gap-2">
                  <h2 class="text-sm font-semibold text-slate-100">{node.alias}</h2>
                  <span class="rounded border border-slate-700 px-1.5 py-0.5 text-xs text-slate-400">
                    {node.shares.length} owners
                  </span>
                </div>
                <p class="selectable mt-0.5 font-mono text-xs text-slate-600" title={node.proTxHash}>
                  {short(node.proTxHash)}
                </p>
              </div>
              <p class="font-mono text-xs text-slate-400">
                {total.toLocaleString()} / {node.collateralAmount.toLocaleString()} DASH
              </p>
            </div>

            {/* Pool fill + signature progress. The fill is the reserved amount
                against the collateral; the signature count is what actually
                gates the broadcast — no transaction exists until every owner
                has signed. Both are derived, not hardcoded. */}
            <div class="border-b border-titan-800 px-4 py-2.5">
              <div class="flex items-center justify-between text-xs text-slate-400">
                <span>
                  {total.toLocaleString()} of {node.collateralAmount.toLocaleString()} DASH reserved
                </span>
                <span class="font-mono text-slate-500">
                  {signedCount} of {node.shares.length} signatures collected
                </span>
              </div>
              <div
                class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-titan-900"
                role="img"
                aria-label="Signature progress"
                data-signature-progress={node.id}
              >
                <div
                  class="h-full rounded-full bg-emerald-500/80"
                  style={`width: ${(signedCount / node.shares.length) * 100}%`}
                />
              </div>
            </div>

            {/* Proportional split bar. */}
            <div class="flex h-1.5 w-full" role="img" aria-label="Share distribution">
              {parts.map((part, i) => (
                <div
                  class:list={[
                    'h-full',
                    i === 0
                      ? 'bg-titan-500'
                      : i === 1
                        ? 'bg-titan-400/70'
                        : 'bg-titan-300/50',
                  ]}
                  style={`width: ${part.pct}%`}
                />
              ))}
            </div>

            <ul class="divide-y divide-titan-800" role="list">
              {parts.map((part) => (
                <li
                  class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2.5 text-xs"
                  data-coowner={part.owner}
                >
                  <span class="w-28 shrink-0 truncate font-medium text-slate-200">{part.owner}</span>
                  <span class="font-mono text-slate-300">{part.amount.toLocaleString()} DASH</span>
                  <span class="font-mono text-xs text-slate-600">{part.pct.toFixed(1)}%</span>
                  <span class="selectable font-mono text-xs text-slate-600" title={part.keyId}>
                    {part.keyId}
                  </span>
                  <span
                    class:list={[
                      'ml-auto inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-xs font-medium',
                      part.signed
                        ? 'border-emerald-500/25 bg-emerald-500/10 text-emerald-300'
                        : 'border-amber-500/25 bg-amber-500/10 text-amber-300',
                    ]}
                    data-signed={part.signed ? 'true' : 'false'}
                    data-share-stage={part.signed ? 'funding-signed' : 'terms-approved'}
                  >
                    {part.signed
                      ? part.owner === 'You'
                        ? 'You — funding signed'
                        : 'Funding signed'
                      : 'Terms approved'}
                  </span>
                </li>
              ))}
            </ul>

            {/* Early-exit terms. Both values are shared_register_prepare
                arguments verified against the live v24 node; these specific
                numbers are MOCK. The zero-penalty warning text is the node's
                own wording from the help output. */}
            {node.earlyExit && (
              <div
                class="border-t border-titan-800 bg-titan-950/60 px-4 py-3 text-xs text-slate-500"
                data-exit-terms={node.id}
              >
                <p class="text-slate-400">Exit terms — fixed at registration</p>
                <p class="mt-1 leading-relaxed">
                  Early exit opens after {earlyExitDays} days, for a penalty of {earlyExitDash} DASH
                  (earlyPeriodBlocks {node.earlyExit.periodBlocks.toLocaleString()} blocks,
                  {' '}earlyPenalty {node.earlyExit.penaltyDuffs.toLocaleString()} duffs). A zero
                  penalty means any participant can force an early exit at no cost beyond the
                  transaction fee — this node charges one instead.
                </p>
                <p class="mt-1 leading-relaxed">
                  Your exit is pre-signed: once the early period ends, a dissolution is already
                  stored with the refund-key backup and never expires, so an owner can recover
                  their principal without anyone's cooperation.
                </p>
              </div>
            )}

            <div class="border-t border-titan-800 bg-titan-950/60 px-4 py-2 text-xs text-slate-600">
              Shares must total exactly {(node.collateralAmount).toLocaleString()} DASH. Shared
              collateral cannot register an Evo node.
            </div>
          </article>
        ))
      }
    </div>

    <!--
      The pool fee, stated on the screen where an owner would look for it rather
      than only in the marketing. It is our recommended price and it is not live;
      it is shown so a co-owner reading the split can see what the arrangement
      will cost before they sign anything.
    -->
    <p class="mt-6 text-xs leading-relaxed text-slate-500" data-pool-fee>
      This is the <span class="text-slate-300">self-custodial</span> pool: every share above pays its own
      reward script and we never hold a key. Our recommended cut is
      {' '}<span class="font-mono text-titan-300">{fees.sharedPoolPercent}%</span> of the gross node reward,
      inside a {fees.sharedPoolBand.lowPercent}–{fees.sharedPoolBand.highPercent}% band. On a node this
      size it comes off the top before the split, so each owner loses the same percentage of their own
      reward. Full self-custody of a whole node costs {fees.selfCustodyPercent}% — see the
      {' '}<a href="/rewards/" class="text-titan-300 underline decoration-dotted hover:text-titan-200">rewards model</a>.
    </p>

    {/* Share-of-pool preview: proportional framing, NOT an APY claim. The
        fraction is the same SplitAmountByShares arithmetic the node uses. */}
    <p class="mt-3 text-xs leading-relaxed text-slate-500" data-pool-preview>
      What that means per share: a {poolShareEarnings.deposit} DASH deposit earns
      {' '}<span class="font-mono text-slate-300">{poolShareEarnings.fraction * 100}% of one node's total rewards</span>,
      before the {fees.sharedPoolPercent}% fee — keeping about
      {' '}{poolShareEarnings.netPerYear.toFixed(2)} DASH a year at the model's assumed node count.
    </p>

    {/* Stage honesty: the lifecycle state above is pre-broadcast. Signed here
        means a signature has been returned, not that anything exists on chain. */}
    <p class="mt-3 text-xs leading-relaxed text-slate-500" data-stage-honesty>
      No coins move yet: signatures above are acknowledgements, and no registration transaction is
      broadcast until every owner has signed and funding is confirmed.
    </p>

    <p class="mt-3 text-xs leading-relaxed text-slate-600">
      MOCK DATA. The share rules above are Dash Core v24 consensus and sourced; the owners,
      amounts and keys are invented. The fee is a recommendation and nothing charges it yet.
    </p>
    </div>
  </div>
</Layout>

<script>
  // The live shared view. Pure mapping lives in fleet-live.ts (tested); this
  // script reads `protx list wallet`, keeps the entries with an on-chain share
  // table, and renders one card per node with the consensus-record facts.
  import { liveRpc } from '../lib/live-rpc';
  import { RpcError } from '../lib/rpc';
  import { toLiveNodeViews, duffsToDash, type ProtxEntry } from '../lib/fleet-live';

  const storage = window.localStorage;
  const $ = <T extends Element = HTMLElement>(sel: string): T | null => document.querySelector<T>(sel);

  const BLOCK_SECONDS = 150; // sourced: src/chainparams.cpp:200 (v24.0.3)

  async function loadShared(): Promise<void> {
    const client = liveRpc(storage);
    const summary = $('[data-shared-summary]');
    const box = $('[data-shared-nodes]');
    const errEl = $('[data-shared-error]');
    if (!client || !box) {
      if (summary) summary.textContent = 'No node configured.';
      return;
    }
    try {
      const entries = (await client.listMasternodes('wallet', true)) as ProtxEntry[];
      const shared = toLiveNodeViews(entries).filter((v) => v.shares.length > 0);
      if (summary) {
        summary.textContent =
          shared.length === 0
            ? 'No shared masternodes in this wallet yet.'
            : `${shared.length} shared node${shared.length === 1 ? '' : 's'} · ` +
              `${shared.reduce((n, v) => n + v.shares.length, 0)} shares on chain`;
      }
      errEl?.classList.add('hidden');
      box.replaceChildren(
        ...shared.map((v) => {
          const card = document.createElement('article');
          card.className = 'overflow-hidden rounded-lg border border-titan-800';
          card.setAttribute('data-live-shared-node', v.proTxHash);

          const head = document.createElement('div');
          head.className =
            'flex flex-wrap items-center justify-between gap-3 border-b border-titan-800 bg-titan-900/60 px-4 py-3';
          const headLeft = document.createElement('div');
          const hash = document.createElement('p');
          hash.className = 'selectable font-mono text-xs text-slate-500';
          hash.title = v.proTxHash;
          hash.textContent = v.shortProTx;
          const meta = document.createElement('p');
          meta.className = 'mt-0.5 font-mono text-xs text-slate-600';
          meta.textContent =
            `registered at height ${v.registeredHeight.toLocaleString()} · ` +
            `operator cut ${v.operatorRewardPercent}%`;
          headLeft.append(hash, meta);
          const headRight = document.createElement('p');
          headRight.className = 'font-mono text-xs text-slate-400';
          headRight.textContent =
            v.health === 'banned'
              ? 'PoSe-banned — no service proofs'
              : v.health === 'revoked'
                ? 'Revoked'
                : 'Enabled';
          headRight.classList.add(
            v.health === 'enabled' ? 'text-emerald-300' : v.health === 'revoked' ? 'text-rose-400' : 'text-amber-400',
          );
          head.append(headLeft, headRight);
          card.append(head);

          const totalDuffs = v.shares.reduce((sum, s) => sum + s.amountDash, 0);
          const list = document.createElement('ul');
          list.className = 'divide-y divide-titan-800';
          list.setAttribute('role', 'list');
          for (const s of v.shares) {
            const li = document.createElement('li');
            li.className = 'flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2.5 text-xs';
            const pct = totalDuffs > 0 ? (s.amountDash / totalDuffs) * 100 : 0;
            const cells: Array<[string, string, string?]> = [
              ['font-mono text-slate-300', `${s.amountDash.toLocaleString()} DASH`],
              ['font-mono text-slate-600', `${pct.toFixed(1)}%`],
              ['selectable font-mono text-slate-600', `refund ${s.refundAddress}`, s.refundAddress],
              ['selectable font-mono text-slate-600', `reward ${s.rewardAddress}`, s.rewardAddress],
              ['selectable font-mono text-slate-600', `owner ${s.ownerAddress}`, s.ownerAddress],
            ];
            for (const [cls, text, title] of cells) {
              const span = document.createElement('span');
              span.className = cls;
              if (title) span.title = title;
              span.textContent = text;
              li.append(span);
            }
            list.append(li);
          }
          card.append(list);

          if (v.earlyExit) {
            const exit = document.createElement('div');
            exit.className = 'border-t border-titan-800 bg-titan-950/60 px-4 py-3 text-xs text-slate-500';
            const days = (v.earlyExit.periodBlocks * BLOCK_SECONDS) / 86400;
            exit.textContent =
              `Exit terms — fixed at registration: early exit after ${days.toLocaleString()} days ` +
              `(earlyPeriodBlocks ${v.earlyExit.periodBlocks.toLocaleString()}), penalty ` +
              `${duffsToDash(v.earlyExit.penaltyDuffs)} DASH. A zero penalty would mean any ` +
              `participant can force an early exit at no cost beyond the fee; this one charges one.`;
            card.append(exit);
          }
          return card;
        }),
      );
    } catch (e) {
      const msg = e instanceof RpcError ? e.message : String(e);
      if (summary) summary.textContent = 'The node could not be read.';
      if (errEl) {
        errEl.textContent = msg;
        errEl.classList.remove('hidden');
      }
    }
  }

  $('[data-shared-refresh]')?.addEventListener('click', () => void loadShared());
  void loadShared();
</script>