---
// apps/desktop/src/pages/signing.astro — Evo Titan
//
// Signature collection. ALL DATA IS MOCK — see src/lib/mock.ts.
//
// Mirrors the SharedSigCollector workflow in Dash Core v24's Qt client: a
// session envelope is circulated, each share owner signs, and every signature
// is verified before it is counted. The human-checkable code exists so
// participants can confirm out-of-band that they are signing the same session.
import Layout from '../layouts/Layout.astro';
import { pendingSignings } from '../lib/mock';

const humanise = (kind: string): string =>
  ({
    ProRegTx: 'Register a provider',
    ProDisTx: 'Dissolve a shared node',
    ProUpServTx: 'Update service address',
  })[kind] ?? kind;
---

<Layout title="Signing" active="signing">
  <div class="mx-auto w-full max-w-4xl px-6 py-6">
    <h1 class="text-xl font-semibold tracking-tight text-white">Signing</h1>
    <p class="mt-1 text-sm text-slate-400">
      Transactions awaiting co-owner signatures. Every signature is verified before it counts.
    </p>

    {
      pendingSignings.length === 0 ? (
        <p class="mt-8 text-sm text-slate-500">Nothing awaiting signatures.</p>
      ) : (
        <div class="mt-6 space-y-4">
          {pendingSignings.map((session) => (
            <article
              class="overflow-hidden rounded-lg border border-titan-800 bg-titan-900/40"
              data-signing={session.id}
            >
              <div class="border-b border-titan-800 px-4 py-3">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <div>
                    <h2 class="text-sm font-semibold text-slate-100">{session.label}</h2>
                    <p class="mt-0.5 text-[11px] text-slate-500">{humanise(session.kind)}</p>
                  </div>

                  <div class="text-right">
                    <p class="text-[10px] tracking-wide text-slate-500 uppercase">
                      Human-checkable code
                    </p>
                    <p
                      class="selectable mt-0.5 font-mono text-sm font-semibold tracking-wider text-titan-300"
                      data-human-code={session.humanCode}
                    >
                      {session.humanCode}
                    </p>
                  </div>
                </div>

                <p class="mt-3 text-[11px] leading-relaxed text-slate-500">
                  Confirm this code with each co-owner over a channel you trust before they sign.
                  Everyone must be signing the same session.
                </p>
              </div>

              <!-- Progress -->
              <div class="px-4 py-3">
                <div class="flex items-center justify-between text-[11px]">
                  <span class="text-slate-400">
                    {session.collected} of {session.required} signatures collected
                  </span>
                  <span class="font-mono text-slate-500">
                    {Math.round((session.collected / session.required) * 100)}%
                  </span>
                </div>
                <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-titan-800">
                  <div
                    class="h-full rounded-full bg-titan-500"
                    style={`width: ${(session.collected / session.required) * 100}%`}
                  />
                </div>
              </div>

              <!-- Participants -->
              <ul class="divide-y divide-titan-800 border-t border-titan-800" role="list">
                {session.shares.map((share) => (
                  <li class="flex items-center gap-3 px-4 py-2.5 text-xs" data-participant={share.owner}>
                    <span
                      class:list={[
                        'flex h-5 w-5 shrink-0 items-center justify-center rounded-full border text-[10px]',
                        share.signed
                          ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300'
                          : 'border-titan-700 bg-titan-800/60 text-slate-500',
                      ]}
                      aria-hidden="true"
                    >
                      {share.signed ? '✓' : '·'}
                    </span>
                    <span class="w-28 shrink-0 truncate font-medium text-slate-200">{share.owner}</span>
                    <span class="font-mono text-[10px] text-slate-600">{share.keyId}</span>
                    <span
                      class:list={[
                        'ml-auto text-[10px] font-medium',
                        share.signed ? 'text-emerald-400' : 'text-slate-500',
                      ]}
                    >
                      {share.signed ? 'Verified' : 'Pending'}
                    </span>
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap gap-2 border-t border-titan-800 bg-titan-950/60 px-4 py-3">
                <button
                  type="button"
                  disabled
                  class="cursor-not-allowed rounded-md border border-titan-800 bg-titan-900 px-3 py-1.5 text-xs font-medium text-slate-500"
                  title="Not available yet"
                >
                  Export session
                </button>
                <button
                  type="button"
                  disabled
                  class="cursor-not-allowed rounded-md border border-titan-800 bg-titan-900 px-3 py-1.5 text-xs font-medium text-slate-500"
                  title="Not available yet"
                >
                  Import signature
                </button>
                <button
                  type="button"
                  disabled
                  class="ml-auto cursor-not-allowed rounded-md border border-titan-700 bg-titan-800/40 px-3 py-1.5 text-xs font-semibold text-slate-500"
                  title="Not available yet"
                >
                  Broadcast
                </button>
              </div>
            </article>
          ))}
        </div>
      )
    }

    <p class="mt-6 text-[11px] leading-relaxed text-slate-600">
      MOCK DATA. Signing is not implemented: src/lib/rpc.ts has no transport and no RPC has been
      verified against dashd. The buttons above are disabled for that reason, not to gate anything.
    </p>
  </div>
</Layout>