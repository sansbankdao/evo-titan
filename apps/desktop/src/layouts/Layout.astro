---
// apps/desktop/src/layouts/Layout.astro — Evo Titan
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import StatusBar from '../components/StatusBar.astro';
import { summary } from '../lib/mock';

interface Props {
  title: string;
  /** Which sidebar entry is active. */
  active?: string;
  /**
   * True for a screen whose content comes from the NETWORK rather than from
   * mock.ts.
   *
   * This exists because the app-level MOCK banner is a blanket claim, and a
   * blanket claim becomes a false statement the moment one screen shows real
   * data. On a live screen the banner would say "no node connected" above rows
   * that were read from a node, and Demo Mode would hide those rows as if they
   * were invented.
   *
   * Setting this:
   *   - swaps the amber MOCK banner for an emerald LIVE banner,
   *   - omits `data-demo-content`, so Demo Mode cannot hide real data,
   *   - omits the "Demo Mode is off" empty state, which claims every screen is
   *     fabricated and would therefore be wrong here.
   *
   * It does NOT weaken the mock banner anywhere else: every other screen keeps
   * the default and is still hidden when Demo Mode is off.
   */
  live?: boolean;
  /**
   * True for a screen whose content is live ONLY WHEN A NODE IS CONFIGURED —
   * the Phase 1 mode (fleet, shared, settings). Such a page keeps its mock
   * rendering for Demo Mode and marks its own sections:
   *
   *   - mock sections carry `data-demo-content` (hidden when Demo Mode is off),
   *   - live sections carry `data-live-content` (shown only when Demo Mode is
   *     off AND a node config is present — see the data-node rules in
   *     global.css),
   *   - controls that are neither fabricated nor live (the connection form)
   *     carry neither attribute and are always reachable,
   *   - `<main>` gets no blanket `data-demo-content`, so the page's own
   *     section markers decide visibility.
   *
   * The banner stays amber mock wording in Demo Mode and gains the emerald
   * LIVE banner (data-notice='live-node') that global.css reveals exactly when
   * Demo Mode is off and a config exists.
   */
  nodeLive?: boolean;
  /**
   * True for a page whose empty state is wrong even with no node configured —
   * Settings, which carries real controls (the connection form and the Demo
   * Mode re-enable). The demo-off empty state claims "every screen is mock",
   * which is false on such a page, so it never shows there.
   */
  hideEmptyState?: boolean;
}

const { title, active, live = false, nodeLive = false, hideEmptyState = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Evo Titan</title>
    <!--
      DEMO MODE, set before first paint.

      This runs inline and synchronously in <head> so the document carries the
      right `data-demo-mode` before anything renders. A deferred script would
      let the mock banner paint and then vanish, which is worse than not having
      the toggle at all.

      Default is ON: this build's entire purpose is the mock-data UI/UX
      session, so the fabricated screens are what a first run should show.
      `localStorage` can throw (private mode, blocked storage), hence the
      try/catch — on failure we fall back to ON rather than rendering a blank
      shell.
    -->
    <script is:inline>
      (() => {
        const KEY = 'evotitan.demoMode';
        let value = 'on';
        try {
          if (localStorage.getItem(KEY) === 'off') value = 'off';
        } catch {
          /* storage unavailable — stay on */
        }
        document.documentElement.dataset.demoMode = value;

        /* NODE MODE, set the same way. 'configured' means a persisted
           endpoint (evotitan.nodeConfig) has a host, user and port — NOT a
           verified connection; the pages' live sections carry their own
           per-fetch status. This is a deliberately inline copy of
           node-config.ts's isConfigured shape: it must run before first paint
           and cannot import modules. Keep the two in step. */
        let node = 'none';
        try {
          const raw = localStorage.getItem('evotitan.nodeConfig');
          if (raw) {
            const c = JSON.parse(raw);
            if (
              c &&
              typeof c.host === 'string' && c.host.length > 0 &&
              typeof c.user === 'string' && c.user.length > 0 &&
              Number.isInteger(c.port) && c.port >= 1 && c.port <= 65535
            ) {
              node = 'configured';
            }
          }
        } catch {
          /* corrupt or unavailable — treat as unconfigured */
        }
        document.documentElement.dataset.node = node;
      })();
    </script>
  </head>
  <body class="flex h-full flex-col overflow-hidden bg-titan-950 text-slate-100 select-none">
    <!--
      MOCK DATA BANNER. This session is UI/UX only; nothing on screen comes
      from a node. The banner is deliberately loud and cannot be dismissed, so
      a screenshot can never be mistaken for real fleet data.

      On a LIVE screen the wording changes rather than the banner disappearing.
      Removing it outright would leave a live screen looking exactly like a
      mock one, which is the confusion the banner exists to prevent — so the
      honest form is a banner that says the opposite, in a different colour.
    -->
    <div
      class:list={[
        'flex shrink-0 items-center justify-center gap-2 border-b px-4 py-1.5 text-xs font-medium',
        live
          ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300'
          : 'border-amber-500/30 bg-amber-500/10 text-amber-300',
      ]}
      data-notice={live ? 'live-data' : 'mock-data'}
    >
      <span
        class:list={[
          'h-1.5 w-1.5 rounded-full',
          live ? 'bg-emerald-400' : 'bg-amber-400',
        ]}
        aria-hidden="true"
      ></span>
      {
        live
          ? 'LIVE DATA — this screen reads from Dash Platform mainnet. Other screens are mock.'
          : 'MOCK DATA — no node connected. All figures are fabricated for UI/UX.'
      }
    </div>

    <!--
      THE NODE BANNER (Phase 1). Present only on nodeLive pages; global.css
      reveals it exactly when Demo Mode is off and a node config exists, and
      the demo rules hide the amber banner in that same state, so exactly one
      banner ever shows. It names the MODE — the live sections below render
      their own per-fetch status and errors, because a configured-but-down
      node must not be described as "connected" anywhere.
    -->
    {nodeLive && (
      <div
        class="flex shrink-0 items-center justify-center gap-2 border-b border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5 text-xs font-medium text-emerald-300"
        data-notice="live-node"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
        LIVE DATA — this screen reads from your Dash node. Other screens are mock.
      </div>
    )}

    <div class="flex min-h-0 flex-1">
      <Sidebar active={active} needsAttention={summary.needsAttention} />

      <div class="flex min-w-0 flex-1 flex-col">
        <!--
          `data-demo-content` is hidden when Demo Mode is off (see global.css).
          Every screen below the banner is fabricated, so switching Demo Mode
          off must take the fabrication with it — a blank pane would be
          confusing, an uncleared pane of invented numbers would be dangerous.
        -->
        <main class="min-h-0 flex-1 overflow-y-auto" data-demo-content={live || nodeLive ? undefined : ''}>
          <slot />
        </main>

        <!--
          The state shown INSTEAD of the mock screens when Demo Mode is off.

          This sits as a sibling of `<main>`, not inside it, because `<main>`
          is hidden in this state and a recovery control inside a hidden
          container cannot be clicked. It carries its own re-enable button so
          Demo Mode can never become a one-way door.
        -->
        <div
          class="min-h-0 flex-1 flex-col items-center justify-center gap-4 px-6 text-center"
          data-when-demo="off"
          data-when-demo-live={live || hideEmptyState ? 'hidden' : undefined}
        >
          <div class="max-w-md">
            <p class="text-sm font-semibold tracking-tight text-slate-200">
              Demo Mode is off
            </p>
            <p class="mt-2 text-xs leading-relaxed text-slate-500">
              No node is configured. The RPC transport exists and is verified
              against a live v24.0.3 node, but every screen still shows
              fabricated data until a node is connected — so the figures are
              hidden rather than left on screen without their warning. Configure
              a node in Settings to switch the fleet screens to live data, or
              turn Demo Mode back on.
            </p>
            <button
              type="button"
              data-demo-enable
              class="mt-4 cursor-pointer rounded-md border border-titan-500/40 bg-titan-500/10 px-3 py-1.5 text-xs font-medium text-titan-200 hover:bg-titan-500/20"
            >
              Turn Demo Mode on
            </button>
          </div>
        </div>

        <StatusBar />
      </div>
    </div>
  </body>
</html>