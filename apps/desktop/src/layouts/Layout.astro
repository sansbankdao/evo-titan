---
// apps/desktop/src/layouts/Layout.astro — Evo Titan
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import StatusBar from '../components/StatusBar.astro';
import { summary } from '../lib/mock';

interface Props {
  title: string;
  /** Which sidebar entry is active. */
  active?: string;
  /**
   * True for a screen whose content comes from the NETWORK rather than from
   * mock.ts.
   *
   * This exists because the app-level MOCK banner is a blanket claim, and a
   * blanket claim becomes a false statement the moment one screen shows real
   * data. On a live screen the banner would say "no node connected" above rows
   * that were read from a node, and Demo Mode would hide those rows as if they
   * were invented.
   *
   * Setting this:
   *   - swaps the amber MOCK banner for an emerald LIVE banner,
   *   - omits `data-demo-content`, so Demo Mode cannot hide real data,
   *   - omits the "Demo Mode is off" empty state, which claims every screen is
   *     fabricated and would therefore be wrong here.
   *
   * It does NOT weaken the mock banner anywhere else: every other screen keeps
   * the default and is still hidden when Demo Mode is off.
   */
  live?: boolean;
}

const { title, active, live = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Evo Titan</title>
    <!--
      DEMO MODE, set before first paint.

      This runs inline and synchronously in <head> so the document carries the
      right `data-demo-mode` before anything renders. A deferred script would
      let the mock banner paint and then vanish, which is worse than not having
      the toggle at all.

      Default is ON: this build's entire purpose is the mock-data UI/UX
      session, so the fabricated screens are what a first run should show.
      `localStorage` can throw (private mode, blocked storage), hence the
      try/catch — on failure we fall back to ON rather than rendering a blank
      shell.
    -->
    <script is:inline>
      (() => {
        const KEY = 'evotitan.demoMode';
        let value = 'on';
        try {
          if (localStorage.getItem(KEY) === 'off') value = 'off';
        } catch {
          /* storage unavailable — stay on */
        }
        document.documentElement.dataset.demoMode = value;
      })();
    </script>
  </head>
  <body class="flex h-full flex-col overflow-hidden bg-titan-950 text-slate-100 select-none">
    <!--
      MOCK DATA BANNER. This session is UI/UX only; nothing on screen comes
      from a node. The banner is deliberately loud and cannot be dismissed, so
      a screenshot can never be mistaken for real fleet data.

      On a LIVE screen the wording changes rather than the banner disappearing.
      Removing it outright would leave a live screen looking exactly like a
      mock one, which is the confusion the banner exists to prevent — so the
      honest form is a banner that says the opposite, in a different colour.
    -->
    <div
      class:list={[
        'flex shrink-0 items-center justify-center gap-2 border-b px-4 py-1.5 text-xs font-medium',
        live
          ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300'
          : 'border-amber-500/30 bg-amber-500/10 text-amber-300',
      ]}
      data-notice={live ? 'live-data' : 'mock-data'}
    >
      <span
        class:list={[
          'h-1.5 w-1.5 rounded-full',
          live ? 'bg-emerald-400' : 'bg-amber-400',
        ]}
        aria-hidden="true"
      ></span>
      {
        live
          ? 'LIVE DATA — this screen reads from Dash Platform mainnet. Other screens are mock.'
          : 'MOCK DATA — no node connected. All figures are fabricated for UI/UX.'
      }
    </div>

    <div class="flex min-h-0 flex-1">
      <Sidebar active={active} needsAttention={summary.needsAttention} />

      <div class="flex min-w-0 flex-1 flex-col">
        <!--
          `data-demo-content` is hidden when Demo Mode is off (see global.css).
          Every screen below the banner is fabricated, so switching Demo Mode
          off must take the fabrication with it — a blank pane would be
          confusing, an uncleared pane of invented numbers would be dangerous.
        -->
        <main class="min-h-0 flex-1 overflow-y-auto" data-demo-content={live ? undefined : ''}>
          <slot />
        </main>

        <!--
          The state shown INSTEAD of the mock screens when Demo Mode is off.

          This sits as a sibling of `<main>`, not inside it, because `<main>`
          is hidden in this state and a recovery control inside a hidden
          container cannot be clicked. It carries its own re-enable button so
          Demo Mode can never become a one-way door.
        -->
        <div
          class="min-h-0 flex-1 flex-col items-center justify-center gap-4 px-6 text-center"
          data-when-demo="off"
          data-when-demo-live={live ? 'hidden' : undefined}
        >
          <div class="max-w-md">
            <p class="text-sm font-semibold tracking-tight text-slate-200">
              Demo Mode is off
            </p>
            <p class="mt-2 text-xs leading-relaxed text-slate-500">
              Every screen in this build is mock data — no node is connected and
              no RPC transport exists yet. With Demo Mode off there is nothing
              to show, so the fabricated figures are hidden rather than left on
              screen without their warning.
            </p>
            <button
              type="button"
              data-demo-enable
              class="mt-4 cursor-pointer rounded-md border border-titan-500/40 bg-titan-500/10 px-3 py-1.5 text-xs font-medium text-titan-200 hover:bg-titan-500/20"
            >
              Turn Demo Mode on
            </button>
          </div>
        </div>

        <StatusBar />
      </div>
    </div>
  </body>
</html>