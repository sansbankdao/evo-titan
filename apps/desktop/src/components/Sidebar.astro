---
// apps/desktop/src/components/Sidebar.astro — Evo Titan
//
// Navigation chrome. The item list is static; the only dynamic value is the
// attention badge, which is MOCK and comes from `mock.ts` via Layout.
interface Props {
  active?: string;
  needsAttention: number;
}

const { active = 'fleet', needsAttention } = Astro.props;

const items = [
  { id: 'fleet', label: 'Fleet', href: '/' },
  { id: 'shared', label: 'Shared nodes', href: '/shared' },
  { id: 'signing', label: 'Signing', href: '/signing' },
  { id: 'rewards', label: 'Rewards', href: '/rewards' },
  { id: 'activity', label: 'Activity', href: '/activity' },
];

// Account-level screens are separated from the fleet views: one group is about
// the nodes, the other is about you. The rule between them makes that split
// legible instead of leaving eight undifferentiated links.
const accountItems = [
  { id: 'profile', label: 'Profile', href: '/profile' },
  { id: 'settings', label: 'Settings', href: '/settings' },
];

// Rank 0 sits in its own group, below a rule, and is labelled as planned. It is
// not a sixth entry in the fleet list: custody is the opposite ownership
// arrangement to every node view above it, and filing it alongside them would
// imply the operator holds collateral they do not hold.
const custodialItem = { id: 'custodial', label: 'Custodial pool', href: '/custodial', planned: true };
---

<aside class="flex w-56 shrink-0 flex-col border-r border-titan-800 bg-titan-900">
  <div class="flex items-center gap-2.5 px-4 py-4">
    <img src="/favicon.svg" alt="" width="26" height="26" class="h-[26px] w-[26px]" />
    <span class="text-sm font-semibold tracking-tight text-white">Evo Titan</span>
  </div>

  <nav class="flex flex-1 flex-col gap-0.5 px-2" aria-label="Primary">
    {
      items.map((item) => {
        const isActive = item.id === active;
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'flex items-center justify-between rounded-md px-3 py-2 text-sm transition',
              isActive
                ? 'bg-titan-800 font-medium text-white'
                : 'text-slate-400 hover:bg-titan-800/50 hover:text-slate-200',
            ]}
            data-nav={item.id}
          >
            <span>{item.label}</span>
            {item.id === 'fleet' && needsAttention > 0 && (
              <span
                class="rounded-full bg-amber-500/20 px-1.5 py-0.5 text-[10px] font-semibold text-amber-300"
                title={`${needsAttention} node(s) need attention`}
              >
                {needsAttention}
              </span>
            )}
          </a>
        );
      })
    }

    <div class="my-1.5 border-t border-titan-800" aria-hidden="true"></div>

    <a
      href={custodialItem.href}
      aria-current={custodialItem.id === active ? 'page' : undefined}
      class:list={[
        'flex items-center justify-between rounded-md px-3 py-2 text-sm transition',
        custodialItem.id === active
          ? 'bg-titan-800 font-medium text-white'
          : 'text-slate-400 hover:bg-titan-800/50 hover:text-slate-200',
      ]}
      data-nav={custodialItem.id}
    >
      <span>{custodialItem.label}</span>
      {custodialItem.planned && (
        <span class="rounded border border-amber-500/30 bg-amber-500/10 px-1.5 py-0.5 text-[9px] font-medium text-amber-300">
          Planned
        </span>
      )}
    </a>

    <div class="my-1.5 border-t border-titan-800" aria-hidden="true"></div>

    {
      accountItems.map((item) => {
        const isActive = item.id === active;
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'flex items-center justify-between rounded-md px-3 py-2 text-sm transition',
              isActive
                ? 'bg-titan-800 font-medium text-white'
                : 'text-slate-400 hover:bg-titan-800/50 hover:text-slate-200',
            ]}
            data-nav={item.id}
          >
            <span>{item.label}</span>
          </a>
        );
      })
    }
  </nav>

  <div class="border-t border-titan-800 p-3">
    <div class="rounded-md bg-titan-950/60 px-3 py-2.5">
      <p class="text-[10px] tracking-wide text-slate-500 uppercase">Plan</p>
      <p class="mt-0.5 text-sm font-medium text-slate-300">Operator</p>
      <p class="mt-1 text-[10px] text-slate-600">Free forever</p>
    </div>
  </div>
</aside>