---
// apps/desktop/src/components/StatusBar.astro — Evo Titan
//
// Bottom chrome. The node counts on the right are MOCK and vanish with Demo
// Mode. The connection indicator on the left is REAL as of Phase 1: it reads
// the persisted endpoint (evotitan.nodeConfig) and reports PRESENCE, not a
// verified connection — "Node endpoint: host:port" with an indigo dot is the
// honest ceiling for a bar that makes no RPC call. Claiming "connected" here
// would be a lie the UI tells.
import { summary } from '../lib/mock';
import { loadNodeConfig } from '../lib/node-config';

// Kept in step with tauri.conf.json by hand: the webview cannot read the
// bundle version, and importing package.json into the client bundle would ship
// the whole manifest. If the version moves, move it here too.
const appVersion = '26.9.26';
---

<footer
  class="flex shrink-0 items-center justify-between gap-4 border-t border-titan-800 bg-titan-900 px-4 py-1.5 text-xs text-slate-500"
  data-notice="status-bar"
>
  <div class="flex items-center gap-4">
    <span class="flex items-center gap-1.5">
      <span class="h-1.5 w-1.5 rounded-full bg-slate-600" data-node-dot aria-hidden="true"></span>
      <span data-node-label>No node configured</span>
    </span>
    <span class="text-slate-700">·</span>
    <span>RPC transport verified (v24.0.3)</span>
  </div>

  <!--
    These are counts of MOCK nodes, so they are tagged `data-demo-content` and
    disappear with Demo Mode. The "No node connected" text on the left is the
    truth and stays: it is the ONLY thing in this bar that is not fabricated.
  -->
  <div class="flex items-center gap-4" data-demo-content>
    <span>{summary.totalNodes} nodes</span>
    <span class="text-slate-700">·</span>
    <span>{summary.enabled} enabled</span>
    {summary.needsAttention > 0 && (
      <>
        <span class="text-slate-700">·</span>
        <span class="text-amber-400/80">{summary.needsAttention} need attention</span>
      </>
    )}
    <span class="text-slate-700">·</span>
    <span class="text-slate-600">v{appVersion}</span>
  </div>
</footer>

<script>
  // Presence, not connection (see the header comment). One storage read, no
  // RPC call, so the bar can never report a state it did not check.
  import { loadNodeConfig } from '../lib/node-config';
  const cfg = loadNodeConfig(window.localStorage);
  const label = document.querySelector('[data-node-label]');
  if (cfg && label) {
    label.textContent = `Node endpoint: ${cfg.host}:${cfg.port}`;
    const dot = document.querySelector('[data-node-dot]');
    dot?.classList.replace('bg-slate-600', 'bg-titan-400');
  }
</script>