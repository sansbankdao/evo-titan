---
// apps/desktop/src/components/RewardsChart.astro — Evo Titan
//
// MOCK DATA. Daily reward income, drawn from `rewardsSeries` in src/lib/mock.ts.
// No value here came from a node; rpc.ts still throws by design.
//
// The series is passed to the client through a data attribute rather than
// fetched, because there is nothing to fetch from.
import type { SeriesPoint } from '../lib/mock';

interface Props {
  points: SeriesPoint[];
  /** Label for the series, shown in the chart header. */
  label?: string;
}

const { points, label = 'Reward income' } = Astro.props;

// Chart.js wants {x, y} pairs. Dates stay ISO strings: the x scale is a
// category axis, so no date adapter is needed and no timezone is applied.
const payload = points.map((p) => ({ x: p.date, y: p.amount }));

const total = points.reduce((sum, p) => sum + p.amount, 0);
const average = points.length > 0 ? total / points.length : 0;
---

<section
  class="rounded-lg border border-titan-800 bg-titan-900/60 p-4"
  data-chart="rewards-trend"
  data-chart-mock="true"
>
  <div class="flex items-baseline justify-between gap-3">
    <div>
      <h2 class="text-sm font-semibold text-slate-200">{label}</h2>
      <p class="mt-0.5 text-[11px] text-slate-500">
        Last {points.length} days · MOCK series
      </p>
    </div>
    <div class="text-right">
      <p class="font-mono text-sm text-slate-100">{total.toFixed(2)} DASH</p>
      <p class="text-[10px] text-slate-500">{average.toFixed(2)} / day average</p>
    </div>
  </div>

  <!--
    maintainAspectRatio:false requires the parent to own the height, otherwise
    the canvas collapses to zero on first paint.
  -->
  <div class="mt-3 h-40">
    <canvas
      id="rewards-trend"
      role="img"
      aria-label={`Reward income over the last ${points.length} days. Mock data.`}
      data-series={JSON.stringify(payload)}
      data-accent="#8b7cf6"
    ></canvas>
  </div>
</section>

<script>
  import Chart from 'chart.js/auto';

  interface Point {
    x: string;
    y: number;
  }

  const canvas = document.getElementById('rewards-trend') as HTMLCanvasElement | null;

  if (canvas) {
    const raw = canvas.dataset.series ?? '[]';
    const points: Point[] = JSON.parse(raw);
    const accent = canvas.dataset.accent ?? '#8b7cf6';

    // Gradient fill. Created from the canvas so it tracks the rendered height
    // rather than assuming a pixel size.
    const ctx = canvas.getContext('2d');
    let fill: string | CanvasGradient = 'rgba(139, 124, 246, 0.12)';
    if (ctx) {
      const gradient = ctx.createLinearGradient(0, 0, 0, canvas.clientHeight || 160);
      gradient.addColorStop(0, 'rgba(139, 124, 246, 0.30)');
      gradient.addColorStop(1, 'rgba(139, 124, 246, 0.02)');
      fill = gradient;
    }

    new Chart(canvas, {
      type: 'line',
      data: {
        labels: points.map((p) => p.x),
        datasets: [
          {
            data: points.map((p) => p.y),
            borderColor: accent,
            backgroundColor: fill,
            borderWidth: 1.5,
            fill: true,
            tension: 0.35,
            pointRadius: 0,
            pointHoverRadius: 3,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        // No animation: this is a fixed mock, and a chart that animates on
        // every load implies live data arriving.
        animation: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            displayColors: false,
            callbacks: {
              label: (item) => `${Number(item.parsed.y).toFixed(2)} DASH`,
            },
          },
        },
        scales: {
          x: {
            grid: { display: false },
            border: { display: false },
            ticks: {
              color: '#64748b',
              font: { size: 10 },
              maxTicksLimit: 6,
              // Show month-day only; the year is constant across the window.
              callback(value) {
                const label = this.getLabelForValue(Number(value));
                return typeof label === 'string' ? label.slice(5) : label;
              },
            },
          },
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(148, 163, 184, 0.10)' },
            border: { display: false },
            ticks: { color: '#64748b', font: { size: 10 }, maxTicksLimit: 4 },
          },
        },
      },
    });
  }
</script>
