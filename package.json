    "format:check": "prettier --check .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@evotitan/config": "workspace:*",
    "@types/node": "26.6.2",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.2",
    "typescript": "6.0.3"
