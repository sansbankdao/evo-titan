{
  "name": "evo-titan",
  "private": true,
  "version": "0.1.0",
  "description": "Evo Titan \u2014 monorepo for web, docs, desktop and mobile.",
  "homepage": "https://evotitan.app",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
