---
// packages/web/src/components/Hero.astro — Evo Titan
import ConsoleMockup from './ConsoleMockup.astro';
import { anyPlatformAvailable, webApp } from '../config/downloads';
import { protocol, site } from '../config/site';
---

<section class="relative overflow-hidden border-b border-slate-800/60">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 -top-40 h-80 bg-[radial-gradient(60%_100%_at_50%_0%,rgba(99,102,241,0.18),transparent_70%)]"
  >
  </div>

  <div
    class="relative mx-auto grid w-full max-w-6xl items-center gap-12 px-6 py-20 sm:py-24 lg:grid-cols-2 lg:gap-10"
  >
    <div>
      <p class="flex items-center gap-2 text-xs font-medium tracking-widest text-indigo-400 uppercase">
        <span class="h-1.5 w-1.5 rounded-full bg-indigo-400" aria-hidden="true"></span>
        Masternode &amp; evonode operations
      </p>

      <h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
        {site.tagline}
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-400">
        {site.lede}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        {
          anyPlatformAvailable ? (
            <a
              href="#download"
              class="rounded-md bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400"
            >
              Download
            </a>
          ) : (
            <span
              aria-disabled="true"
              title="Downloads are not available yet"
              class="cursor-not-allowed rounded-md border border-slate-700 bg-slate-900/60 px-5 py-3 text-sm font-semibold text-slate-400"
            >
              Download
              <span class="sr-only"> — coming soon</span>
            </span>
          )
        }

        {
          webApp.available ? (
            <a
              href={webApp.href}
              class="rounded-md border border-slate-700 px-5 py-3 text-sm font-semibold text-slate-200 transition hover:bg-slate-900"
            >
              {webApp.action}
            </a>
          ) : (
            <span
              aria-disabled="true"
              title={`${webApp.name} — coming soon`}
              class="cursor-not-allowed rounded-md border border-slate-800 bg-slate-900/40 px-5 py-3 text-sm font-semibold text-slate-500"
            >
              {webApp.action}
              <span class="sr-only"> — coming soon</span>
            </span>
          )
        }

        <a
          href="#product"
          class="rounded-md px-5 py-3 text-sm font-semibold text-slate-300 transition hover:text-white"
        >
          See what it does
        </a>
      </div>

      <p class="mt-6 font-mono text-xs text-slate-600">
        {protocol.minShares}–{protocol.maxShares} co-owners · {protocol.regularCollateral.toLocaleString()}
        {' '}DASH regular · {protocol.evoCollateral.toLocaleString()} DASH evo · min share {protocol.minShareAmount} DASH
      </p>
    </div>

    <ConsoleMockup />
  </div>
</section>
