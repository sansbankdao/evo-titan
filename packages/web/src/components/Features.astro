---
// packages/web/src/components/Features.astro — Evo Titan
//
// MOCK FEATURE COPY, sourced from src/config/site.ts so the wording lives in one
// place and can be replaced without touching markup.
import { features } from '../config/site';

// Inline icons keep the page free of an icon runtime.
const icons: Record<string, string> = {
  share:
    'M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM17 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM8 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM10.5 7.5l4-2M10.5 16.5l4 2',
  pulse: 'M3 12h4l3-7 4 14 3-7h4',
  coins: 'M12 6c4.4 0 8-1.3 8-3s-3.6-3-8-3-8 1.3-8 3 3.6 3 8 3ZM4 3v6c0 1.7 3.6 3 8 3s8-1.3 8-3V3M4 9v6c0 1.7 3.6 3 8 3s8-1.3 8-3V9',
  shield: 'M12 3l7 3v6c0 4.4-3 8.2-7 9.6C8 20.2 5 16.4 5 12V6l7-3Z',
  bell: 'M18 9a6 6 0 1 0-12 0c0 6-2 7-2 7h16s-2-1-2-7ZM10.5 20a2 2 0 0 0 3 0',
  layers: 'M12 3l9 5-9 5-9-5 9-5ZM3 13l9 5 9-5M3 17l9 5 9-5',
};
---

<section class="mx-auto w-full max-w-6xl px-6 py-20">
  <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Built for operators</h2>

  <ul class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" role="list">
    {
      features.map((feature) => (
        <li>
          <span
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-800 bg-slate-900/60 text-indigo-400"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <path d={icons[feature.icon]} />
            </svg>
          </span>
          <h3 class="mt-4 text-base font-semibold text-slate-100">{feature.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{feature.body}</p>
        </li>
      ))
    }
  </ul>
</section>
