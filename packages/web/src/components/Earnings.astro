---
// packages/web/src/components/Earnings.astro — Evo Titan
//
// FEATURES the reward numbers, derived from Dash Core v24 consensus.
//
// The page previously hid the reward behind a calculator the visitor had to
// fill in themselves. That is honest but useless: nobody arrives knowing that a
// masternode pays out at all. This section states the numbers up front, then
// lets the visitor move the two things that are genuinely unknown (node count
// and fee rate) and watch the result change.
//
// Every derived figure cites its source in `yieldModel`. The single unsourced
// input is the node count `N`, which is live network state we cannot read from
// this machine — so it is exposed as a control and labelled as the assumption.
import { yieldModel, fees, protocol, custodial } from '../config/site';

const { perBlock, apyByNodeCount } = yieldModel;

// The headline: a Regular node at 4,000, the middle of our assumed range.
// The fallback is unreachable (4,000 is always in `apyByNodeCount`) but it keeps
// the component total: `noUncheckedIndexedAccess` types an index as possibly
// undefined, and a non-null assertion would hide a real mistake if the row were
// ever removed from the config.
const base =
  apyByNodeCount.find((row) => row.nodes === 4000) ??
  ({ nodes: 4000, regularApy: 9.15, evoApy: 2.29 } as const);

// Custodial worked example. A 125 DASH share of an 8-way 1,000 DASH node.
const shareFraction = 125 / protocol.regularCollateral;
const grossSharePerYear = (yieldModel.annualMasternodePot / base.nodes) * shareFraction;
const custodialKeeps = grossSharePerYear * (1 - fees.custodialPercent / 100);

const money = (n: number, digits = 2): string =>
  n.toLocaleString(undefined, { minimumFractionDigits: digits, maximumFractionDigits: digits });
---

<section
  id="earnings"
  class="border-y border-slate-800/60 bg-slate-950/40"
  data-earnings
  data-masternode-pot={String(yieldModel.annualMasternodePot)}
  data-collateral-regular={String(protocol.regularCollateral)}
  data-collateral-evo={String(protocol.evoCollateral)}
>
  <div class="mx-auto w-full max-w-6xl scroll-mt-20 px-6 py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-medium tracking-widest text-indigo-400 uppercase">
          What a node actually pays
        </p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-3xl">
          The reward, worked out from the protocol
        </h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-400">
          These are not marketing figures. Every number below is arithmetic on Dash Core v24 consensus
          rules, and each input is cited in the source. One figure cannot be derived — the number of
          registered masternodes — so we show it as an assumption you can move.
        </p>
      </div>
      <p
        class="rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1.5 text-xs font-medium text-amber-300"
        data-notice="derived"
      >
        Derived from v24 source — not a live reading
      </p>
    </div>

    <!-- The block reward, decomposed.

         Colour and size carry the hierarchy, so the important number is not
         simply the last one read. Block value and the Platform cut are context
         and sit at slate/rose; the two masternode figures sit at indigo/white,
         and the NET figure — the number that actually reaches an operator — is
         the largest type on the row. -->
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-5" data-block-figure="value">
        <p class="text-xs tracking-wide text-slate-500 uppercase">Block value</p>
        <p class="mt-2 font-mono text-2xl text-slate-400">{money(perBlock.blockValue, 6)}</p>
        <p class="mt-1 text-xs text-slate-500">
          DASH per block, after the 20% treasury and the interval decline
        </p>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-5" data-block-figure="gross">
        <p class="text-xs tracking-wide text-indigo-400/80 uppercase">Masternode reward, gross</p>
        <p class="mt-2 font-mono text-3xl text-indigo-300">{money(perBlock.masternodeRewardGross, 6)}</p>
        <p class="mt-1 text-xs text-slate-500">
          {yieldModel.masternodeShareOfBlockValue * 100}% of block value — {money(perBlock.masternodeRewardGross * yieldModel.blocksPerYear)} DASH/yr
        </p>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-5" data-block-figure="platform">
        <p class="text-xs tracking-wide text-rose-400/80 uppercase">Less: Platform credit pool</p>
        <p class="mt-2 font-mono text-3xl text-rose-300">−{money(perBlock.platformCreditPool, 6)}</p>
        <p class="mt-1 text-xs text-slate-500">
          {yieldModel.platformShareOfMasternodeReward * 100}% of the masternode share
        </p>
      </div>

      <div
        class="rounded-xl border-2 border-indigo-500/40 bg-indigo-500/10 p-5"
        data-block-figure="net"
      >
        <p class="text-xs font-semibold tracking-wide text-indigo-200 uppercase">Masternode reward, net</p>
        <p class="mt-2 font-mono text-4xl font-semibold text-white">{money(perBlock.masternodeRewardNet, 6)}</p>
        <p class="mt-1 text-xs text-indigo-200/70">
          DASH per block — {money(yieldModel.annualMasternodePot, 0)} DASH/yr across every node
        </p>
      </div>
    </div>

    <!-- APY by node count, with the assumption visible -->
    <div class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]">
      <div class="overflow-hidden rounded-xl border border-slate-800">
        <table class="w-full text-left">
          <caption class="sr-only">
            Estimated annual percentage yield by assumed number of registered masternodes,
            for Regular (1,000 DASH) and Evo (4,000 DASH) collateral.
          </caption>
          <thead class="bg-slate-900/60">
            <tr class="text-xs tracking-wide text-slate-400 uppercase">
              <th scope="col" class="px-4 py-3 font-medium">Registered nodes</th>
              <th scope="col" class="px-4 py-3 font-medium">Reward / node / yr</th>
              <th scope="col" class="px-4 py-3 text-right font-medium text-indigo-300">Regular · 1,000 DASH</th>
              <th scope="col" class="px-4 py-3 text-right font-medium text-slate-400">Evo · 4,000 DASH</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60">
            {
              apyByNodeCount.map((row) => {
                const perNode = yieldModel.annualMasternodePot / row.nodes;
                const isBase = row.nodes === base.nodes;
                return (
                  <tr
                    class={isBase ? 'bg-indigo-500/10' : ''}
                    data-apy-row={String(row.nodes)}
                  >
                    <td class="px-4 py-3 font-mono text-sm text-slate-300">
                      {row.nodes.toLocaleString()}
                      {isBase && (
                        <span class="ml-2 rounded border border-indigo-500/30 px-1.5 py-0.5 text-xs text-indigo-300">
                          example
                        </span>
                      )}
                    </td>
                    <td
                      class:list={[
                        'px-4 py-3 font-mono',
                        isBase ? 'text-base text-slate-200' : 'text-sm text-slate-400',
                      ]}
                    >
                      {money(perNode, 2)} DASH
                    </td>
                    <td
                      class:list={[
                        'px-4 py-3 text-right font-mono font-semibold',
                        isBase ? 'text-2xl text-indigo-200' : 'text-base text-indigo-300/80',
                      ]}
                      data-apy="regular"
                    >
                      {money(row.regularApy)}%
                    </td>
                    <td
                      class:list={[
                        'px-4 py-3 text-right font-mono',
                        isBase ? 'text-lg text-slate-400' : 'text-sm text-slate-500',
                      ]}
                      data-apy="evo"
                    >
                      {money(row.evoApy)}%
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-5">
        <p class="text-xs tracking-wide text-slate-500 uppercase">Move the assumption</p>
        <label for="apy-nodes" class="mt-3 flex items-baseline justify-between text-sm font-medium text-slate-300">
          <span>Registered nodes</span>
          <output for="apy-nodes" id="apy-nodes-out" class="font-mono text-xs text-indigo-300"
            >{base.nodes.toLocaleString()}</output
          >
        </label>
        <input
          id="apy-nodes"
          name="apyNodes"
          type="range"
          min="2500"
          max="6000"
          step="50"
          value={base.nodes}
          class="mt-3 w-full accent-indigo-500"
        />

        <dl class="mt-5 space-y-3 border-t border-slate-800 pt-4 text-sm">
          <div class="flex items-baseline justify-between gap-4">
            <dt class="text-slate-400">Reward / node / yr</dt>
            <dd class="font-mono text-base text-slate-300"><span data-apy-pernode>—</span> DASH</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 rounded-lg border border-indigo-500/20 bg-indigo-500/5 px-3 py-2">
            <dt class="text-indigo-200">Regular APY</dt>
            <dd class="font-mono text-3xl font-semibold text-indigo-200"><span data-apy-out-regular>—</span>%</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 px-3">
            <dt class="text-slate-500">Evo APY</dt>
            <dd class="font-mono text-lg text-slate-500"><span data-apy-out-evo>—</span>%</dd>
          </div>
        </dl>

        <p class="mt-4 text-xs leading-relaxed text-slate-500">
          The pot shrinks about 7.1% every {yieldModel.subsidyIntervalBlocks.toLocaleString()} blocks, so this
          falls over time on its own.
        </p>
      </div>
    </div>

    <!-- The custodial comparison -->
    <div class="mt-10 rounded-xl border border-dashed border-slate-700 bg-slate-950/60 p-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h3 class="text-lg font-semibold text-white">Same node, shared — and run for you</h3>
        <span class="rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 text-xs font-medium text-amber-300">
          Our fee: {fees.custodialPercent}%
        </span>
      </div>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-slate-400">
        A 125 DASH share of an 8-way {protocol.regularCollateral.toLocaleString()} DASH node earns
        {' '}{money(shareFraction * 100, 1)}% of the node reward, because Dash Core splits by collateral
        ({' '}<span class="font-mono text-slate-500">SplitAmountByShares</span>). The custodial service takes
        {' '}{fees.custodialPercent}% of the gross reward. Here is the difference, at
        {' '}{base.nodes.toLocaleString()} nodes:
      </p>

      <div class="mt-5 grid gap-4 sm:grid-cols-3">
        <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-4">
          <p class="text-xs tracking-wide text-slate-500 uppercase">Gross on 125 DASH</p>
          <p class="mt-2 font-mono text-2xl text-slate-300">{money(grossSharePerYear, 4)}</p>
          <p class="mt-1 text-xs text-slate-500">DASH / year, before our fee</p>
        </div>
        <div class="rounded-lg border border-rose-500/20 bg-rose-500/5 p-4">
          <p class="text-xs tracking-wide text-rose-300/80 uppercase">Less {fees.custodialPercent}% fee</p>
          <p class="mt-2 font-mono text-2xl text-rose-300">
            −{money(grossSharePerYear - custodialKeeps, 4)}
          </p>
          <p class="mt-1 text-xs text-rose-300/50">DASH / year to us</p>
        </div>
        <div class="rounded-lg border-2 border-indigo-500/40 bg-indigo-500/10 p-4">
          <p class="text-xs font-semibold tracking-wide text-indigo-200 uppercase">You keep</p>
          <p class="mt-2 font-mono text-4xl font-semibold text-white">{money(custodialKeeps, 4)}</p>
          <p class="mt-1 text-xs text-indigo-200/70">
            DASH / year → {money((custodialKeeps / 125) * 100)}% on 125 DASH
          </p>
        </div>
      </div>

      <p class="mt-4 border-t border-slate-800 pt-3 text-xs leading-relaxed text-amber-300/80">
        {custodial.notice} The {fees.custodialPercent}% and the figures above are a worked example at an
        assumed node count, not an offer.
      </p>

      <!--
        The sourced comparison.

        Every number here is quoted from a pinned Wayback snapshot of CrowdNode's
        own knowledge base, and the two rows are not interchangeable: custodial
        fees are charged where the provider holds the funds, non-custodial where
        the depositor keeps the keys. Our 30% is compared only to the custodial
        figure, and our shared-pool band only to the non-custodial one.
      -->
      <div class="mt-5 border-t border-slate-800 pt-4" data-competitor-comparison>
        <h4 class="text-xs font-semibold tracking-wide text-slate-400 uppercase">
          How that compares, from the source
        </h4>
        <dl class="mt-3 grid gap-3 sm:grid-cols-3">
          {
            fees.competitorSurvey
              .filter((c) => c.publishable)
              .map((c) => (
                <div class="rounded-lg border border-slate-800 bg-slate-950/40 p-3">
                  <dt class="text-xs text-slate-500">{c.basis}</dt>
                  <dd class="mt-1 font-mono text-2xl text-slate-300">{c.percentOfRewards}%</dd>
                  <dd class="mt-1 text-xs text-slate-600">
                    {c.name.split(' — ')[1] ?? c.name}
                  </dd>
                  <dd class="mt-1">
                    <a
                      href={c.snapshot}
                      rel="noreferrer nofollow noopener"
                      target="_blank"
                      class="text-xs text-indigo-400 underline decoration-indigo-500/40 underline-offset-2 hover:text-indigo-300"
                    >
                      snapshot ↗
                    </a>
                  </dd>
                </div>
              ))
          }
        </dl>
        <p class="mt-3 text-xs leading-relaxed text-slate-500">
          CrowdNode, quoted from its own knowledge-base article
          {' '}<span class="font-mono">knowledge.crowdnode.io/en/articles/2225953</span>. The fee is a
          cut of the <span class="text-slate-400">reward</span>, not of the deposit. The custodial rate
          moved from 15% to 35% between the two captures below; both are shown so the change is
          visible rather than averaged. This is a competitor snapshot, not a claim about our own terms:
          our custodial rate is the {fees.custodialPercent}% above, and our shared-pool rate is a
          recommendation ({fees.sharedPoolBand.lowPercent}–{fees.sharedPoolBand.highPercent}%, i.e.
          {fees.sharedPoolBand.recommendedPercent}% suggested), which nothing charges yet.
        </p>
      </div>
    </div>

    <p class="mt-8 text-xs leading-relaxed text-slate-500">
      Sources, Dash Core v24.0.0-rc.1: block time and subsidy interval
      {' '}<span class="font-mono">src/chainparams.cpp</span> ({yieldModel.blockSeconds}s,
      {' '}{yieldModel.subsidyIntervalBlocks.toLocaleString()} blocks); subsidy base, treasury and the 1/14 decline
      {' '}<span class="font-mono">src/validation.cpp</span> ({' '}GetBlockSubsidyHelper); masternode share and the
      Platform cut <span class="font-mono">src/masternode/payments.cpp</span> ({' '}GetMasternodePayment,
      {' '}PlatformShare); collateral sizes <span class="font-mono">src/evo/dmn_types.h</span>. The node count is
      the only unsourced input, and it is yours to set above.
    </p>
  </div>
</section>

<script>
  // Only the node-count slider does arithmetic, and it does the SAME arithmetic
  // the build did, so the server-rendered table and the interactive panel can
  // never disagree. The pot is passed in rather than recomputed from constants,
  // so there is one source of truth.
  const root = document.querySelector<HTMLElement>('[data-earnings]');
  const POT = Number(root?.dataset.masternodePot ?? '0');
  const COLLATERAL_REGULAR = Number(root?.dataset.collateralRegular ?? '1000');
  const COLLATERAL_EVO = Number(root?.dataset.collateralEvo ?? '4000');
  const range = document.querySelector<HTMLInputElement>('#apy-nodes');
  const outNodes = document.querySelector<HTMLOutputElement>('#apy-nodes-out');
  const outPerNode = document.querySelector<HTMLElement>('[data-apy-pernode]');
  const outRegular = document.querySelector<HTMLElement>('[data-apy-out-regular]');
  const outEvo = document.querySelector<HTMLElement>('[data-apy-out-evo]');

  const fmt = (n: number, d = 2) =>
    n.toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d });

  if (range && outNodes && outPerNode && outRegular && outEvo && POT > 0) {
    const render = () => {
      const n = Number(range.value);
      const perNode = POT / n;
      outNodes.textContent = n.toLocaleString();
      outPerNode.textContent = fmt(perNode);
      outRegular.textContent = fmt((perNode / COLLATERAL_REGULAR) * 100);
      outEvo.textContent = fmt((perNode / COLLATERAL_EVO) * 100);
    };
    range.addEventListener('input', render);
    render();
  }
</script>
