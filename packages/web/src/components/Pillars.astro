---
// packages/web/src/components/Pillars.astro — Evo Titan
import { pillars } from '../config/site';
---

<section id="product" class="mx-auto w-full max-w-6xl scroll-mt-20 px-6 py-20">
  <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">What Evo Titan does</h2>
  <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-400">
    Four things, in the order they matter to an operator.
  </p>

  <div class="mt-10 grid gap-5 lg:grid-cols-2">
    {
      pillars.map((pillar, index) => (
        <article
          class="group relative overflow-hidden rounded-xl border border-slate-800 bg-slate-900/40 p-6 transition hover:border-slate-700"
          data-pillar={pillar.id}
        >
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs text-slate-600">0{index + 1}</span>
            <span class="rounded-full border border-indigo-500/25 bg-indigo-500/10 px-2.5 py-0.5 text-[11px] font-medium text-indigo-300">
              {pillar.label}
            </span>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-slate-100">{pillar.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-400">{pillar.body}</p>
        </article>
      ))
    }
  </div>
</section>
