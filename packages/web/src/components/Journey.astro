---
// packages/web/src/components/Journey.astro — Evo Titan
//
// The operator's path, ending at a first Evo node and then the rank the product
// is named for. Stage requirements are sourced Dash Core v24 consensus; the
// ranks and stage labels are Evo Titan's own positioning language, marked as
// such in the config and in the footnote below.
import { journey, levels, protocol } from '../config/site';
---

<section id="path" class="border-y border-slate-800/60 bg-slate-950/40">
  <div class="mx-auto w-full max-w-6xl scroll-mt-20 px-6 py-20">
    <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{journey.title}</h2>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-400">
      Start with a fraction of a masternode. Finish running an evonode of your own — then as many
      as you need, until you are an Evo Titan.
    </p>

    <ol class="mt-12 grid gap-px overflow-hidden rounded-xl border border-slate-800 bg-slate-800 lg:grid-cols-5" role="list">
      {
        journey.stages.map((stage) => {
          const isEvo = stage.id === 'evonode';
          const isTitan = stage.id === 'titan';
          return (
            <li
              class:list={[
                'relative flex flex-col p-5',
                isTitan ? 'bg-indigo-950/50' : isEvo ? 'bg-indigo-950/30' : 'bg-slate-950',
              ]}
              data-stage={stage.id}
              data-evo={isEvo ? 'true' : undefined}
              data-titan={isTitan ? 'true' : undefined}
            >
              <div class="flex items-baseline justify-between gap-2">
                <span
                  class:list={[
                    'font-mono text-xs',
                    isTitan ? 'text-indigo-300' : isEvo ? 'text-indigo-400' : 'text-slate-600',
                  ]}
                >
                  {stage.step}
                </span>
                <span
                  class:list={[
                    'rounded-full border px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide',
                    isTitan
                      ? 'border-indigo-400/40 text-indigo-300'
                      : 'border-slate-700 text-slate-500',
                  ]}
                  data-rank={stage.rank}
                >
                  Rank {stage.rank}
                </span>
              </div>

              <h3
                class:list={[
                  'mt-4 text-sm font-semibold',
                  isTitan ? 'text-white' : isEvo ? 'text-indigo-200' : 'text-slate-100',
                ]}
              >
                {stage.label}
              </h3>

              <p
                class:list={[
                  'mt-1 font-mono text-xs',
                  isTitan ? 'text-indigo-300/90' : isEvo ? 'text-indigo-400/90' : 'text-slate-500',
                ]}
              >
                {stage.amount}
              </p>

              <p class="mt-3 text-xs leading-relaxed text-slate-400">{stage.body}</p>
            </li>
          );
        })
      }
    </ol>

    <div class="mt-8 rounded-xl border border-slate-800 bg-slate-900/40 p-5" data-notice="levels">
      <h3 class="text-sm font-semibold text-slate-200">The ranks</h3>
      <ol class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-5" role="list">
        {
          levels.map((level) => (
            <li
              class:list={[
                'rounded-lg border p-3',
                level.titan ? 'border-indigo-500/35 bg-indigo-500/10' : 'border-slate-800',
              ]}
              data-level={level.name.toLowerCase().replaceAll(' ', '-')}
            >
              <p class="font-mono text-[10px] tracking-wide text-slate-500 uppercase">
                Rank {level.rank}
              </p>
              <p
                class:list={[
                  'mt-1 text-sm font-semibold',
                  level.titan ? 'text-indigo-200' : 'text-slate-200',
                ]}
              >
                {level.name}
              </p>
              <p class="mt-0.5 font-mono text-[11px] text-slate-500">{level.requirement}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="mt-6 text-xs leading-relaxed text-slate-500">
      {journey.note} Masternode collateral is {protocol.regularCollateral.toLocaleString()} DASH and
      an evonode is {protocol.evoCollateral.toLocaleString()} DASH. A shared masternode is limited to
      {' '}{protocol.minShares}–{protocol.maxShares} co-owners with no share below
      {' '}{protocol.minShareAmount} DASH, and shared collateral cannot register an evonode.
    </p>
  </div>
</section>