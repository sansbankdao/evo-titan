---
// packages/web/src/components/DownloadCard.astro — Evo Titan
import type { Platform } from '../config/downloads';

interface Props {
  platform: Platform;
}

const { platform } = Astro.props;

// Icon paths for each platform, kept inline so the page ships no icon runtime.
const icons: Record<Platform['id'], string> = {
  desktop:
    'M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 14.5v-9ZM9 20h6M12 16v4',
  android:
    'M6 9.5A1.5 1.5 0 0 1 7.5 8h9A1.5 1.5 0 0 1 18 9.5v7a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 16.5v-7ZM9 5l1.2 2.2M15 5l-1.2 2.2M9.5 12h.01M14.5 12h.01',
  ios: 'M12 4.5c1.6-2 4.4-1.6 4.4 1.2 0 1.7-1.2 3-2.4 3s-3.6-2.2-2-4.2ZM7.5 9.8c2-.6 3.4.6 4.5.6s2.5-1.2 4.5-.6c2.3.7 3 3.4 2.4 6-.6 2.6-2.1 4.7-3.6 4.7-1 0-1.6-.6-3.3-.6s-2.3.6-3.3.6c-1.5 0-3.1-2.1-3.7-4.7-.6-2.6.1-5.3 2.5-6Z',
};

const icon = icons[platform.id];
---

<li
  class="group relative flex flex-col rounded-xl border border-slate-800 bg-slate-900/40 p-6 transition hover:border-slate-700 hover:bg-slate-900/70"
  data-platform={platform.id}
  data-available={String(platform.available)}
>
  <div class="flex items-center gap-3">
    <span
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-slate-800 bg-slate-950 text-indigo-400"
      aria-hidden="true"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        <path d={icon}></path>
      </svg>
    </span>
    <div>
      <h3 class="text-base font-semibold text-slate-100">{platform.name}</h3>
      <p class="text-xs text-slate-500">{platform.meta}</p>
    </div>
  </div>

  <p class="mt-4 flex-1 text-sm leading-relaxed text-slate-400">{platform.description}</p>

  <div class="mt-6">
    {
      platform.available ? (
        <a
          href={platform.href}
          class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400"
          rel="noopener noreferrer"
        >
          {platform.action}
        </a>
      ) : (
        <span
          aria-disabled="true"
          title={`${platform.name} — coming soon`}
          class="inline-flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-md border border-slate-800 bg-slate-950/60 px-4 py-2.5 text-sm font-semibold text-slate-500"
        >
          {platform.action}
          <span class="sr-only"> — coming soon</span>
        </span>
      )
    }
  </div>
</li>
