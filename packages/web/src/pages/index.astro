---
// packages/web/src/pages/index.astro — Evo Titan
import Layout from '../layouts/Layout.astro';
---

<Layout title="Evo Titan">
  <main class="mx-auto flex w-full max-w-3xl flex-1 flex-col justify-center gap-6 px-6 py-24">
    <p class="text-sm font-medium tracking-widest text-indigo-400 uppercase">app.evotitan</p>
    <h1 class="text-5xl font-bold tracking-tight">Evo Titan</h1>
    <p class="text-lg text-slate-400">
      Desktop, mobile and web. Built with Astro, Tauri v2, React Native and Tailwind CSS.
    </p>
    <nav class="flex flex-wrap gap-3">
      <a
        href="https://evotitan.app/v1/health"
        class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500"
      >
        API status
      </a>
      <a
        href="/docs/"
        class="rounded-md border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-200 hover:bg-slate-900"
      >
        Documentation
      </a>
    </nav>
  </main>
</Layout>
